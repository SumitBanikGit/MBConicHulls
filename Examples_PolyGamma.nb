 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"76e92377-2083-4c12-8c68-065c6ca1cd07"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"I1Rep", "=", 
   RowBox[{"MBRep", "[", 
    RowBox[{"1", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["z", "1"], "\[Rule]", 
        RowBox[{
         RowBox[{"-", "7"}], "/", "9"}]}], ",", 
       RowBox[{
        SubscriptBox["z", "2"], "\[Rule]", 
        RowBox[{
         RowBox[{"-", "3"}], "/", "5"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["x", "1"], ",", 
       SubscriptBox["x", "2"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          SubscriptBox["z", "1"]}], ",", 
         RowBox[{"-", 
          SubscriptBox["z", "2"]}], ",", 
         RowBox[{"1", "+", 
          SubscriptBox["z", "1"], "+", 
          SubscriptBox["z", "2"]}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", 
           RowBox[{"1", "+", 
            SubscriptBox["z", "1"], "+", 
            SubscriptBox["z", "2"]}]}], "}"}]}], "}"}], ",", 
       RowBox[{"{", "}"}]}], "}"}], ",", 
     RowBox[{"PolygammaToGamma", "->", "True"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.974606763442254*^9, 3.9746067702532167`*^9}, 
