Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"MBIntegrand", "=", 
   RowBox[{
    RowBox[{
     SuperscriptBox["u", "z4"], 
     SuperscriptBox["v", "z6"], 
     SuperscriptBox[
      RowBox[{"Gamma", "[", 
       RowBox[{"-", "z4"}], "]"}], "2"], 
     SuperscriptBox[
      RowBox[{"Gamma", "[", 
       RowBox[{"-", "z6"}], "]"}], "2"], 
     SuperscriptBox[
      RowBox[{"Gamma", "[", 
       RowBox[{"1", "+", "z4", "+", "z6"}], "]"}], "2"], 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
