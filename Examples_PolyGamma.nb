Cell[CellGroupData[{

Cell[TextData[{
 "Example 2: Master integral ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    RowBox[{"8", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "a71b006f-26ae-48da-bd6b-c171745929e3"],
 " for  g g \[Rule] h at ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["N", "3"], TraditionalForm]],ExpressionUUID->
  "249f134e-7746-4d51-b6d1-d6f109f2f23b"],
 "LO"
}], "Section",
 CellChangeTimes->{{3.8285998172621365`*^9, 3.8285998262131433`*^9}, {
  3.9746052690594597`*^9, 3.974605355654984*^9}, {3.9746054180348587`*^9, 
  3.974605440106022*^9}, {3.97479923355886*^9, 3.974799233638648*^9}, {
  3.974885983012846*^9, 
  3.974885989797871*^9}},ExpressionUUID->"701d3c22-d8e7-4791-a27c-\
a20f263faddf"],

Cell[TextData[{
 "Our goal is to compute the MB integral ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    RowBox[{"8", ",", "2"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "7ad14279-687c-4235-a69b-48e744d506e6"],
 " in Eq. (8.49) of https://doi.org/10.1007/JHEP07(2013)003. Since the \
integral is symmetric under ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["z", "3"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "3b5a21d0-cf17-47ac-8fbd-994e5885e7e4"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["z", "4"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "37b133cd-f7f3-4973-a3ad-cd84e3375aaf"],
 ", we need evaluate only ",
 StyleBox["four",
  FontWeight->"Bold"],
 " distinct MB integrals with straight contours, three of which contain ",
 StyleBox["polygamma",
  FontWeight->"Bold"],
 " function "
}], "Text",
 CellChangeTimes->{{3.832761547315897*^9, 3.8327615541774206`*^9}, {
   3.8327639584884076`*^9, 3.8327640143726587`*^9}, {3.832823475176058*^9, 
