      0, 1 + Subscript[MBConicHulls`n, 1] - Subscript[MBConicHulls`n, 2]]) - 
    2 Log[
      Subscript[$CellContext`x, 1]] 
    PolyGamma[
     0, 1 + Subscript[MBConicHulls`n, 1] - Subscript[MBConicHulls`n, 2]] + 
    PolyGamma[
      0, 1 + Subscript[MBConicHulls`n, 1] - Subscript[MBConicHulls`n, 2]]^2 - 
    3 PolyGamma[1, 1 - Subscript[MBConicHulls`n, 2]] + 
    PolyGamma[
     1, 1 + Subscript[MBConicHulls`n, 1] - Subscript[MBConicHulls`n, 2]]) 
   Subscript[$CellContext`x, 1]^(-1 - Subscript[MBConicHulls`n, 1] + 
     Subscript[MBConicHulls`n, 2]) 
   Subscript[$CellContext`x, 2]^Subscript[MBConicHulls`n, 1], 
   And[Subscript[MBConicHulls`n, 1] >= 0, Subscript[MBConicHulls`n, 2] == 0]],
  Editable->False]], "Print",
