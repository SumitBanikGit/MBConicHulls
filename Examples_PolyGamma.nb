Cell[TextData[{
 "The first MB corresponds to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    RowBox[{"8", ",", "2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "140fb8cd-3b10-4bb8-b39f-53ca2f808113"],
 " in https://arxiv.org/abs/2512.19803. We have introduced two artificial \
scales ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", "1"], TraditionalForm]],ExpressionUUID->
  "3ee2969b-33e9-4394-b38c-c4639494fc11"],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"and", " ", 
    SubscriptBox["u", "2"]}], TraditionalForm]],ExpressionUUID->
  "1b085a4d-0146-4e1a-a6af-6b40690a361c"],
 " for conic hull or triangulation methods to work. However, we will set ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "1"], "\[Rule]", "1"}], TraditionalForm]],
  ExpressionUUID->"93733c4b-88ef-41af-bd9b-47d0fbbb1bd3"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["u", "2"], "\[Rule]", "1"}], TraditionalForm]],
  ExpressionUUID->"83fd3806-ba5a-48dc-be62-e795c7c85ad5"],
 " at a later stage."
}], "Text",
 CellChangeTimes->{{3.832761547315897*^9, 3.8327615541774206`*^9}, {
