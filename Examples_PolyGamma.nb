   3.974607892486082*^9, 3.9746079259688797`*^9}, {3.974609964188588*^9, 
   3.974609969263659*^9}, {3.975149351692854*^9, 3.975149355612336*^9}, {
   3.975149514643982*^9, 3.975149614323154*^9}, {3.975149652901348*^9, 
   3.975149702254072*^9}, {3.975149748053615*^9, 3.975149814045198*^9}, {
   3.975150058611546*^9, 3.975150144772134*^9}, {3.975150451324194*^9, 
   3.975150452620296*^9}, {3.975150489570066*^9, 3.9751504990696793`*^9}, {
   3.975150664969636*^9, 3.975150734183281*^9}, 3.975150774133193*^9},
 FontSize->10,
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"288e9b7b-a86e-441e-b210-9559ed02bf18"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"Phi2", "[", 
     RowBox[{"z_", ",", "zbar_"}], "]"}], ":=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"-", "1"}], ")"}], "^", "r"}], "*", 
       RowBox[{
        RowBox[{"Factorial", "[", 
         RowBox[{"4", "-", "r"}], "]"}], "/", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Factorial", "[", "r", "]"}], "*", 
          RowBox[{"Factorial", "[", 
           RowBox[{"2", "-", "r"}], "]"}], "*", 
          RowBox[{"2", "!"}]}], ")"}]}], "*", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"z", " ", "zbar"}], "]"}], "^", "r"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"PolyLog", "[", 
          RowBox[{
           RowBox[{"4", "-", "r"}], ",", "z"}], "]"}], "-", 
         RowBox[{"PolyLog", "[", 
          RowBox[{
           RowBox[{"4", "-", "r"}], ",", "zbar"}], "]"}]}], ")"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"r", ",", "0", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"I2", "[", 
    RowBox[{"z_", ",", "zbar_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "1"}], "/", 
     RowBox[{"(", " ", 
      RowBox[{"(", 
       RowBox[{"z", "-", "zbar"}], ")"}], ")"}]}], "*", 
    RowBox[{"Phi2", "[", 
     RowBox[{
      RowBox[{"z", "/", 
       RowBox[{"(", 
        RowBox[{"z", "-", "1"}], ")"}]}], ",", 
      RowBox[{"zbar", "/", 
       RowBox[{"(", 
        RowBox[{"zbar", "-", "1"}], ")"}]}]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.97498468656282*^9, 3.974984686567608*^9}, {
  3.974984763284008*^9, 3.97498476645944*^9}, {3.9750442405371227`*^9, 
  3.9750442441804247`*^9}},
 CellLabel->"In[83]:=",ExpressionUUID->"4c217683-66de-4404-8497-faf71b7d9fef"],

