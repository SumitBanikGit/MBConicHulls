aca1575fc52b"],

Cell[TextData[{
 "In the first case, we set ",
 StyleBox["PolygammaToGamma->True, ",
  FontWeight->"Bold"],
 "to allow the polygamma function to be written in terms of gamma function"
}], "Text",
 CellChangeTimes->{{3.832761547315897*^9, 3.8327615541774206`*^9}, {
   3.8327639584884076`*^9, 3.8327640143726587`*^9}, {3.832823475176058*^9, 
