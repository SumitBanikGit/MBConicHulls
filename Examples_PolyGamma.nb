Cell[CellGroupData[{

Cell["Example 1: Toy Integral", "Section",
 CellChangeTimes->{{3.8285998172621365`*^9, 3.8285998262131433`*^9}, {
   3.9746052690594597`*^9, 3.974605355654984*^9}, {3.9746054180348587`*^9, 
   3.974605440106022*^9}, {3.97479923355886*^9, 3.974799233638648*^9}, {
   3.9748311826972322`*^9, 3.974831187850088*^9}, 3.9907324075171213`*^9, 
   3.990732454537819*^9},ExpressionUUID->"7b6d9550-5320-4d33-ae5b-\
227a5bb8b193"],

Cell[TextData[{
 "Here we will compute the MB integral ",
 Cell[BoxData[
  FormBox[
   RowBox[{"I", "(", 
    RowBox[{
     SubscriptBox["x", "1"], ",", 
     SubscriptBox["x", "2"]}], ")"}], TraditionalForm]],ExpressionUUID->
  "7a15afbb-b7bb-4b2c-9c95-fa132554e635"],
 " in Eq. 3.1 of https://arxiv.org/abs/2512.19803 in ",
 StyleBox["two",
  FontWeight->"Bold"],
 " different ways. In first case, we will do it by rewriting polygamma in \
terms of gamma, and it second case rewrite polygamma as a sum of other \
polygamma functions."
}], "Text",
 CellChangeTimes->{{3.832761547315897*^9, 3.8327615541774206`*^9}, {
   3.8327639584884076`*^9, 3.8327640143726587`*^9}, {3.832823475176058*^9, 
   3.832823477539287*^9}, {3.832823513412715*^9, 3.832823519847609*^9}, 
   3.832823555968794*^9, {3.8328236078154087`*^9, 3.8328236122013197`*^9}, {
   3.974606619677894*^9, 3.974606757720752*^9}, {3.9746097313457317`*^9, 
   3.974609786982806*^9}, {3.9748311954265413`*^9, 3.974831342122233*^9}, {
   3.9748352438341513`*^9, 3.974835247383295*^9}, {3.9758942015717793`*^9, 
   3.975894202498526*^9}},
 FontSize->10,
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"a71b20d2-67b7-432d-a875-c738b3994832"],

