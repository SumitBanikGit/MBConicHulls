Cell[TextData[{
 "We finally cross-check our series solution with known analytic result and \
direct numerical integration using ",
 StyleBox["MB.m. ",
  FontWeight->"Bold"],
 "Our result matches perfectly with numerical integration but has an overall ",
 StyleBox["sign difference ",
  FontWeight->"Bold"],
 "with the analytic solution. This is currently under investigation."
}], "Text",
