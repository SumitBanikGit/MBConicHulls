Cell[TextData[{
 "The following MB integral corresponds to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["F", 
    RowBox[{"8", ",", "2", ",", "3"}]], TraditionalForm]],ExpressionUUID->
  "793751d6-9d0d-4c58-9988-ba511d95d076"],
 " in https://arxiv.org/abs/2512.19803. Note that as the straight contour \
split the poles of ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Psi]", "(", 
    RowBox[{"0", ",", 
     SubscriptBox["z", "3"]}]}], TraditionalForm]],ExpressionUUID->
  "8ef4ec9d-9a83-4f1a-8166-b7dba1d79909"],
 "), that function is ",
 StyleBox["rewritten",
  FontWeight->"Bold"],
 " in terms of gamma functions by introducing an auxiliary variable ",
 Cell[BoxData[
  SubscriptBox["\[Iota]", "11"]],
  CellChangeTimes->{{3.974607048128992*^9, 3.974607059912632*^9}, 
    3.974607974879719*^9},ExpressionUUID->
  "9799b650-7876-4ba0-a796-86c972150a1d"]
}], "Text",
