  0.87, 0.94, 1],ExpressionUUID->"1f56e3e9-c266-4c4a-8c59-30c292c765ae"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"SumLim", "=", "2"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Increase", " ", "this", " ", "for", " ", "better", " ", "accuracy"}], " ",
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Dim", "=", "9"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NSeriesDBNonRes", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SetSharedVariable", "[", "NSeriesDBNonRes", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SumlimTabel", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["n", "i"], ",", "0", ",", "SumLim"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "Dim"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NPrecision", "=", "71"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Increase", " ", "this", " ", "for", " ", "higher", " ", "numerical", " ", 
    "precision"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Time Taken: \>\"", ",", "\[IndentingNewLine]", " ", 
    RowBox[{
     RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
      RowBox[{"Monitor", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Do", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{
           RowBox[{"CondExtract", "=", 
            RowBox[{"SeriesConditionNonRes", "[", 
             RowBox[{"[", "i", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
           RowBox[{"SeriesExtract", "=", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"DBSeriesDiffNonRes", "[", "i", "]"}], "*", 
                  RowBox[{"(", 
                   RowBox[{
                    RowBox[{"(", 
                    RowBox[{"-", 
                    RowBox[{"Gamma", "[", "l", "]"}]}], ")"}], "/", 
                    SuperscriptBox["\[Pi]", 
                    RowBox[{
                    RowBox[{"DD", "/", "2"}], "-", "1"}]]}], ")"}]}], ")"}], "/.",
                 "ConformalConstraintDB"}], "/.", "DiffEqConstraintDB"}], "/.",
               "PropagatorSubNonResDB"}], "/.", "ParameterSubDB"}]}], ";", 
           " ", "\[IndentingNewLine]", 
           RowBox[{"NSeriesDBNonRes", "=", 
            RowBox[{"Insert", "[", 
             RowBox[{"NSeriesDBNonRes", ",", 
              RowBox[{"ParallelSum", "[", 
               RowBox[{
                RowBox[{"If", "[", 
                 RowBox[{"CondExtract", ",", 
                  RowBox[{
                   RowBox[{"N", "[", 
                    RowBox[{"SeriesExtract", ",", "NPrecision"}], "]"}], "//",
                    "Quiet"}], ",", "0"}], "]"}], ",", 
                RowBox[{"Evaluate", "[", 
                 RowBox[{"Sequence", "@@", "SumlimTabel"}], "]"}]}], "]"}], ",", 
              RowBox[{"-", "1"}]}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"i", ",", 
            RowBox[{"Length", "@", "SeriesConditionNonRes"}]}], "}"}]}], 
         "]"}], "\[IndentingNewLine]", ",", 
        RowBox[{"{", 
         RowBox[{"ProgressIndicator", "[", 
          RowBox[{"i", ",", 
           RowBox[{"{", 
            RowBox[{"1", ",", 
             RowBox[{"Length", "@", "SeriesConditionNonRes"}]}], "}"}]}], 
          "]"}], "}"}]}], "]"}], "\[IndentingNewLine]", "\[IndentingNewLine]",
       "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], ",", "\"\< seconds\>\""}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{"\"\<Numerical Value: \>\"", ",", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"Total", "@", "NSeriesDBNonRes"}], ",", "NPrecision"}], "]"}]}], 
  "]"}]}], "Input",
