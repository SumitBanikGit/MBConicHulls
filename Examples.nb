Cell["\<\
Differentiating the series representation of the Double Box in order to \
validate its differential equation relation with the Hexagon.\
\>", "Text",
 CellChangeTimes->{{3.8327768854479074`*^9, 3.832776976459507*^9}, {
  3.8327770103590784`*^9, 3.8327770133996167`*^9}, {3.832777056808815*^9, 
  3.8327772146283092`*^9}, {3.8327776283634005`*^9, 3.832777715145812*^9}, {
