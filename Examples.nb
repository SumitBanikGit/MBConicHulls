                    Subscript[
                    MBConicHulls`\[Omicron], MBConicHulls`Private`i] + 
                    Part[MBConicHulls`Private`MBNumArg, 
                    MBConicHulls`Private`i, 2]}]]; Null]; Null]; Null, {
                  MBConicHulls`Private`i, 
                   Length[MBConicHulls`Private`MBNumArg]}]; 
                MBConicHulls`Private`MBArgNew = 
