          MBConicHulls`Private`PrintSol = 
          OptionValue[MBConicHulls`PrintSolutions], 
          MBConicHulls`Private`ShortOnly = 
          OptionValue[MBConicHulls`ShortestOnly], 
          MBConicHulls`Private`RegOnly = True, MBConicHulls`Private`Card = 
          OptionValue[MBConicHulls`Cardinality], MBConicHulls`Private`MaxCard = 
          OptionValue[MBConicHulls`MaxCardinality], 
          MBConicHulls`Private`QSolve = OptionValue[MBConicHulls`QuickSolve], 
          MBConicHulls`Private`SolSummary = 
          OptionValue[MBConicHulls`SolutionSummary], 
          MBConicHulls`Private`TPCommand = "points2alltriangs", 
          MBConicHulls`Private`ProportionalQ, 
          MBConicHulls`Private`AnyProportionalQ, MBConicHulls`Private`Cof, 
          MBConicHulls`Private`Num, MBConicHulls`Private`NumCof, 
          MBConicHulls`Private`DenCof, MBConicHulls`Private`Delta, 
          MBConicHulls`Private`ResolveMBOut, MBConicHulls`Private`BreakTri = 
          False, MBConicHulls`Private`ATrim, MBConicHulls`Private`NumGamma, 
          MBConicHulls`Private`DenGamma, MBConicHulls`Private`NumFlat, 
          MBConicHulls`Private`DenFlat, MBConicHulls`Private`MBRepVarsFlatten,
