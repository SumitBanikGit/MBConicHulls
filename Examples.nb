Cell["Mellin - Barnes Representation and Solutions", "Subsection",
 CellChangeTimes->{{3.8289558056651745`*^9, 3.828955831385947*^9}, {
  3.832989576265738*^9, 3.8329896092265882`*^9}, {3.898770758615781*^9, 
