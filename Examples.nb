Cell[CellGroupData[{

Cell["Convergence Regions ", "Subsubsection",
 CellChangeTimes->{{3.828600213007632*^9, 
  3.8286002448588276`*^9}},ExpressionUUID->"511985f0-d3b8-4c6b-868e-\
dfd34eae6b3f"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"AppellConvReg", "[", "1", "]"}], "=", 
   RowBox[{"ImplicitRegion", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "x", "]"}], " ", "<", " ", "1"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Abs", "[", "y", "]"}], " ", "<", " ", "1"}]}], " ", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "100"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", "100"}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"AppellConvReg", "[", "2", "]"}], "=", 
   RowBox[{"ImplicitRegion", "[", "  ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "y", "]"}], " ", ">", " ", "1"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Abs", "[", "x", "]"}], " ", "<", " ", "1"}]}], ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "100"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", "100"}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AppellConvReg", "[", "3", "]"}], "=", 
   RowBox[{"ImplicitRegion", "[", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "y", "]"}], " ", "<", "1"}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Abs", "[", "x", "]"}], " ", ">", " ", "1"}]}], "  ", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "100"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", "100"}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AppellConvReg", "[", "4", "]"}], "=", 
   RowBox[{"ImplicitRegion", "[", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "x", "]"}], "<", 
       RowBox[{"Abs", "[", "y", "]"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Abs", "[", "x", "]"}], " ", ">", " ", "1"}]}], " ", ",", " ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "100"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", "100"}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"AppellConvReg", "[", "5", "]"}], "=", 
   RowBox[{"ImplicitRegion", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Abs", "[", "x", "]"}], ">", 
       RowBox[{"Abs", "[", "y", "]"}]}], " ", "&&", " ", 
      RowBox[{
       RowBox[{"Abs", "[", "y", "]"}], " ", ">", " ", "1"}]}], " ", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "100"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"y", ",", "0", ",", "100"}], "}"}]}], "}"}]}], "]"}]}], 
  ";"}]}], "Input",
