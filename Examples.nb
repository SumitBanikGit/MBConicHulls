  RowBox[{
   RowBox[{"AppellSumLim", "=", "100"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Increase", " ", "this", " ", "for", " ", "better", " ", "accuracy"}], " ",
    "*)"}]}], "\[IndentingNewLine]", 
