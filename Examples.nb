                 AllTrue[
                  Part[MBConicHulls`Private`TrivializeSeriesOut, 2], Head[#] === 
                  List& ]], MBConicHulls`Private`TrivialQ = True; 
                MBConicHulls`Private`TrivializeSeriesOut = Transpose[
                   SortBy[
                    Transpose[MBConicHulls`Private`TrivializeSeriesOut], 
                    Length[
                    Part[#, 2]]& ]]; 
                MBConicHulls`Private`SeriesLengthList = Sort[
                   Tally[
                    Map[Length, 
                    Part[MBConicHulls`Private`TrivializeSeriesOut, 2]]]]; 
                MBConicHulls`Private`AllSeries = 
                 Part[MBConicHulls`Private`TrivializeSeriesOut, 1]; 
                MBConicHulls`Private`SeriesNumber = 
                 Length[MBConicHulls`Private`AllSeries]; 
                MBConicHulls`Private`SeriesCondition = Map[Apply[And, 
                    Thread[# >= 0]]& , 
                   Part[MBConicHulls`Private`TrivializeSeriesOut, 2]]; 
                MBConicHulls`Private`CalculateResidueReturn = 
                 ReplacePart[
                  MBConicHulls`Private`CalculateResidueReturn, 1 -> 
                   MBConicHulls`Private`SeriesNumber]; 
                MBConicHulls`Private`CalculateResidueReturn = 
                 ReplacePart[
                  MBConicHulls`Private`CalculateResidueReturn, 2 -> 
                   MBConicHulls`Private`AllSeries]; 
                MBConicHulls`Private`CalculateResidueReturn = 
                 ReplacePart[
                  MBConicHulls`Private`CalculateResidueReturn, 4 -> 
                   MBConicHulls`Private`SeriesCondition], 
                Print["Note: this series cannot be rearranged into trivial \
(canonical) form; returning the non-rearranged series instead."]; 
                MBConicHulls`Private`TrivialQ = False; 
                MBConicHulls`Private`SeriesLengthList = {}]; Null]; 
            Do[MBConicHulls`Private`Msg3 = Insert[MBConicHulls`Private`Msg3, 
                 StringForm[
                 "Series Number `1` :: `2` valid for `3`", 
                  MBConicHulls`Private`i, 
                  Part[
                  MBConicHulls`Private`AllSeries, MBConicHulls`Private`i], 
                  Part[
                  MBConicHulls`Private`SeriesCondition, 
                   MBConicHulls`Private`i]], -1]; Null, {
              MBConicHulls`Private`i, MBConicHulls`Private`SeriesNumber}]; 
            MBConicHulls`Private`Msg4 = 
             StringForm[
              "The series solution is a sum of the following `` series.", 
               MBConicHulls`Private`SeriesNumber]; 
            Print[MBConicHulls`Private`Msg4]; 
            If[MBConicHulls`Private`Rearrange, 
              Do[Print["Found ", 
                 Part[MBConicHulls`Private`i, 2], " series of ", 
                 Part[MBConicHulls`Private`i, 1], "-fold."]; Null, {
               MBConicHulls`Private`i, 
                MBConicHulls`Private`SeriesLengthList}]]; 
            If[MBConicHulls`Private`PrintSol, 
              Do[Print[
                 Part[MBConicHulls`Private`Msg3, MBConicHulls`Private`i]]; 
               Print[""], {
               MBConicHulls`Private`i, MBConicHulls`Private`SeriesNumber}]]; 
            Null]; Print["Time Taken ", 
           Part[MBConicHulls`Private`TimeTaken, 1], " seconds"]; Return[
           Append[
           MBConicHulls`Private`CalculateResidueReturn, 
            MBConicHulls`Private`TrivialQ]]]}], "SubValues" -> None, 
    "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> {
     MBConicHulls`PrintSeries -> True, MBConicHulls`RearrangeSeries -> False, 
      MBConicHulls`RunInParallel -> True}, "Attributes" -> {}, "FullName" -> 
