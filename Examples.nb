Cell[CellGroupData[{

Cell["Auto Generator", "Subsection",
 CellChangeTimes->{{3.8285998890705976`*^9, 3.8285999067710447`*^9}, {
  3.89764367065032*^9, 3.897643671358465*^9}, {3.900578929356633*^9, 
  3.900578932308427*^9}},ExpressionUUID->"cd8045f1-cb12-4430-8993-\
984155e6724e"],

Cell["\<\
Module to automatically generate the MB representation of the one-loop \
n-point Massless Feynman Diagram. See https://doi.org/10.1063/1.529383\
\>", "Text",
 CellChangeTimes->{{3.832761547315897*^9, 3.8327615541774206`*^9}, {
   3.8327639584884076`*^9, 3.8327640143726587`*^9}, {3.832823475176058*^9, 
   3.832823477539287*^9}, {3.832823513412715*^9, 3.832823519847609*^9}, 
   3.832823555968794*^9, {3.8328236078154087`*^9, 3.8328236122013197`*^9}, {
   3.8991188245616817`*^9, 3.899118864182144*^9}, {3.9005789593737955`*^9, 
   3.900578978512032*^9}},
 FontSize->10,
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"af255902-debe-4d0a-acd4-4341cc38e4d3"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MergeInt", "[", "x_", "]"}], ":=", 
   RowBox[{"FromDigits", "@", 
    RowBox[{"StringJoin", "@", 
     RowBox[{"IntegerString", "[", "x", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"GenerateMBNPoint", "[", "n_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "GammaSet1", ",", "GammaSet2", ",", "GammaSet3", ",", "GammaSet4", ",", 
      "GammaSet5", ",", "AllPosComb", ",", "PropPowers"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Clear", "[", 
      RowBox[{"{", 
       RowBox[{"z", ",", "k", ",", "d"}], "}"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AllPosComb", "=", 
      RowBox[{"Complement", "[", 
       RowBox[{
        RowBox[{"Subsets", "[", 
         RowBox[{
          RowBox[{"Range", "@", "n"}], ",", 
          RowBox[{"{", "2", "}"}]}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"{", 
          RowBox[{"1", ",", "n"}], "}"}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"IntVars", "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["z", 
         RowBox[{"MergeInt", "@", "#"}]], "&"}], "/@", "AllPosComb"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"MBVars", "=", 
      RowBox[{
       RowBox[{
        FractionBox[
         SuperscriptBox[
          SubscriptBox["k", 
           RowBox[{"MergeInt", "@", "#"}]], "2"], 
         SuperscriptBox[
          SubscriptBox["k", 
           RowBox[{"MergeInt", "[", 
            RowBox[{"{", 
             RowBox[{"1", ",", "n"}], "}"}], "]"}]], "2"]], "&"}], "/@", 
       "AllPosComb"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"PropPowers", "=", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Nu]", "#"], "&"}], "/@", 
       RowBox[{"Range", "@", "n"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GammaSet1", "=", 
      RowBox[{"-", "IntVars"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GammaSet2", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Total", "@", "PropPowers"}], "-", 
        RowBox[{"d", "/", "2"}], "+", 
        RowBox[{"Total", "@", "IntVars"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GammaSet3", "=", 
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"PropPowers", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "+", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["z", 
             RowBox[{"MergeInt", "@", "#"}]], "&"}], "/@", 
           RowBox[{"Select", "[", 
            RowBox[{"AllPosComb", ",", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "<", "i"}], "&&", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], "==", "i"}]}], "&"}]}], 
            "]"}]}], "]"}], "+", 
         RowBox[{"Total", "[", 
          RowBox[{
           RowBox[{
            SubscriptBox["z", 
             RowBox[{"MergeInt", "@", "#"}]], "&"}], "/@", 
           RowBox[{"Select", "[", 
            RowBox[{"AllPosComb", ",", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ">", "i"}], "&&", 
               RowBox[{
                RowBox[{"#", "[", 
                 RowBox[{"[", "1", "]"}], "]"}], "==", "i"}]}], "&"}]}], 
            "]"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "2", ",", 
          RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"GammaSet4", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"d", "/", "2"}], "-", 
        RowBox[{"Total", "@", "PropPowers"}], "+", 
        SubscriptBox["\[Nu]", "1"], "-", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           SubscriptBox["z", 
            RowBox[{"MergeInt", "@", "#"}]], "&"}], "/@", 
          RowBox[{"Select", "[", 
           RowBox[{"AllPosComb", ",", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "!=", "1"}], "&&", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "<", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}]}], "&"}]}], "]"}]}], "]"}]}],
        "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"GammaSet5", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"d", "/", "2"}], "-", 
        RowBox[{"Total", "@", "PropPowers"}], "+", 
        SubscriptBox["\[Nu]", "n"], "-", 
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{
           SubscriptBox["z", 
            RowBox[{"MergeInt", "@", "#"}]], "&"}], "/@", 
          RowBox[{"Select", "[", 
           RowBox[{"AllPosComb", ",", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "!=", "n"}], "&&", 
              RowBox[{
               RowBox[{"#", "[", 
                RowBox[{"[", "1", "]"}], "]"}], "<", 
               RowBox[{"#", "[", 
                RowBox[{"[", "2", "]"}], "]"}]}]}], "&"}]}], "]"}]}], "]"}]}],
        "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"NumArg", "=", 
      RowBox[{"Join", "[", 
       RowBox[{
       "GammaSet1", ",", "GammaSet2", ",", "GammaSet3", ",", "GammaSet4", ",",
         "GammaSet5"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Derived \>\"", ",", 
       RowBox[{"Length", "@", "IntVars"}], 
       ",", "\"\<-fold MB Representation.\>\""}], "]"}], ";"}]}], 
   "\[IndentingNewLine]", "]"}]}]}], "Input",
 CellChangeTimes->{{3.9005785324794455`*^9, 3.9005785442832527`*^9}, {
  3.900578777985407*^9, 3.9005788505950594`*^9}, {3.90057944961768*^9, 
  3.9005794844775734`*^9}, {3.900601204447775*^9, 3.900601255853826*^9}, {
  3.9007371056259527`*^9, 3.9007372022519913`*^9}, {3.902500891843144*^9, 
  3.9025009139402113`*^9}, {3.902500975746771*^9, 3.9025009841647997`*^9}},
 CellLabel->
  "In[234]:=",ExpressionUUID->"08acd5d4-ae55-473d-aa8f-3da35c88b7b3"]
}, Closed]],

