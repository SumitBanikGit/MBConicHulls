Cell[BoxData[
 RowBox[{
  RowBox[{
  "We", " ", "first", " ", "generate", " ", "a", " ", "random", " ", "point", 
   " ", 
   RowBox[{"(", 
    RowBox[{
     SubscriptBox["u", "1"], ",", 
     SubscriptBox["u", "2"]}], ")"}], " ", "inside", " ", "the", " ", 
   "convergence", " ", "region", " ", "of", " ", "series", " ", "number", " ", 
   RowBox[{"AppellSeriesNumber", ".", " ", "Then"}]}], ",", 
  RowBox[{"for", " ", "that", " ", "point"}], ",", " ", 
  RowBox[{
  "we", " ", "numerically", " ", "sum", " ", "the", " ", "series", " ", "in", 
   " ", "parallel", " ", "with", " ", "the", " ", "upper", " ", "limit", " ", 
   "of", " ", "each", " ", "summation", " ", "variables", " ", "equal", " ", 
   "to", " ", "AppellSumLim", " ", "and", " ", "compare", " ", "it", " ", 
   "with", " ", "the", " ", "inbuilt", " ", "AppellF1", " ", "function", " ", 
   "of", " ", 
   RowBox[{"Mathematica", "."}]}]}]], "Text",
