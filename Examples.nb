                    "MBConicHulls`Private`LList", ",", 
                    "MBConicHulls`Private`Prec"}], "}"}], ",", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"MBConicHulls`Private`VarSyms", ",", 
                    "MBConicHulls`Private`VarPat", ",", 
                    "MBConicHulls`Private`TermW", ",", 
                    "MBConicHulls`Private`Pts", ",", 
                    "MBConicHulls`Private`NVecs", ",", 
                    "MBConicHulls`Private`VarSub", ",", 
                    "MBConicHulls`Private`SpFns", ",", 
