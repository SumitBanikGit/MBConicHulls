           Print["The MB number to be evaluated is greater than the total \
number of series solution found."]; Abort[]]; 
         If[Length[MBConicHulls`Private`MBRepInput] > 1, 
           Print["Solving MB Number : ", MBConicHulls`Private`MBNumberVal]]; 
         MBConicHulls`Private`MBRepVars = Part[
            Part[
            MBConicHulls`Private`MBRepInput, 
             MBConicHulls`Private`MBNumberVal], {1, 2, 3, 4}]; 
         MBConicHulls`Private`Dim = MBConicHulls`Private`MBRepDim[
            Part[
            MBConicHulls`Private`MBRepInput, 
             MBConicHulls`Private`MBNumberVal]]; 
         MBConicHulls`Private`AllPosSub = Subsets[
            Range[
             MBConicHulls`Private`MBRepDim[
              Part[
              MBConicHulls`Private`MBRepInput, 
               MBConicHulls`Private`MBNumberVal]]], {
            MBConicHulls`Private`Dim - 1}]; MBConicHulls`Private`IntVar = Part[
            Part[
            MBConicHulls`Private`MBRepInput, 
             MBConicHulls`Private`MBNumberVal], 2]; 
         MBConicHulls`Private`Num = Part[
            Part[
            MBConicHulls`Private`MBRepInput, 
             MBConicHulls`Private`MBNumberVal], 4, 1]; 
         MBConicHulls`Private`NumGamma = (Select[#, Head[#] =!= List& ]& )[
            Part[MBConicHulls`Private`MBRepVars, 4, 1]]; 
         MBConicHulls`Private`DenGamma = (Select[#, Head[#] =!= List& ]& )[
            Part[MBConicHulls`Private`MBRepVars, 4, 2]]; 
         MBConicHulls`Private`NumFlat = (Select[#, Head[#] =!= Integer& ]& )[
            Flatten[
             Part[MBConicHulls`Private`MBRepVars, 4, 1]]]; 
         MBConicHulls`Private`DenFlat = (Select[#, Head[#] =!= Integer& ]& )[
            Flatten[
             Part[MBConicHulls`Private`MBRepVars, 4, 2]]]; 
         MBConicHulls`Private`MBRepVarsFlatten = 
          ReplacePart[
           MBConicHulls`Private`MBRepVars, {{4, 1} -> 
             MBConicHulls`Private`NumFlat, {4, 2} -> 
             MBConicHulls`Private`DenFlat}]; 
         MBConicHulls`Private`MBRepVarsGamma = 
          ReplacePart[
           MBConicHulls`Private`MBRepVars, {{4, 1} -> 
             MBConicHulls`Private`NumGamma, {4, 2} -> 
             MBConicHulls`Private`DenGamma}]; 
         MBConicHulls`Private`Cof = 
          MBConicHulls`Private`MakeCof[MBConicHulls`Private`MBRepVarsFlatten]; 
         MBConicHulls`Private`TimeTaken = AbsoluteTiming[If[
              And[Head[MBConicHulls`Private`Card] != Symbol, 
               NotElement[MBConicHulls`Private`Card, PositiveIntegers]], 
              Print["Cardinality can only be set to non-negative integers"]; 
              Abort[]]; If[
              And[Head[MBConicHulls`Private`MaxCard] != Symbol, 
               NotElement[MBConicHulls`Private`MaxCard, PositiveIntegers]], 
              Print["MaxCardinality can only be set to non-negative \
integers"]; Abort[]]; 
            If[MBConicHulls`Private`SolSummary, 
              MBConicHulls`Private`PrintSol = False; 
              MBConicHulls`Private`MSeries = False; 
              MBConicHulls`Private`ShortOnly = False]; If[
              And[MBConicHulls`Private`QSolve, 
               Or[
               Head[MBConicHulls`Private`Card] === Integer, 
                Head[MBConicHulls`Private`MaxCard] === Integer]], 
              Print[
              "Cardinality or Maxcardinality can't be set during QuickRun. \
Ignoring them!"]]; {
              MBConicHulls`Private`A, MBConicHulls`Private`ATrim, 
               MBConicHulls`Private`NumLength} = 
             MBConicHulls`Private`FindMBAMatrix[
              MBConicHulls`Private`MBRepVarsFlatten]; 
            Print["The associated A-matrix for this MB integral is ", 
              MatrixForm[MBConicHulls`Private`ATrim]]; 
            MBConicHulls`Private`CheckCommand = 
             "which " <> OptionValue[MBConicHulls`TopComPath] <> 
              "points2triangs"; If[StringLength[
                
                RunProcess[$SystemShell, "StandardOutput", 
                 MBConicHulls`Private`CheckCommand]] === 0, 
              Print["TOPCOM executables not found at ", 
                OptionValue[MBConicHulls`TopComPath], 
                ". Provide the correct location of executables using the ", 
                Style["TopComPath", Bold], " option."]; Abort[]]; 
            If[Length[MBConicHulls`Private`ATrim] === 1, 
              Print["Triangulation Method currently works only when the \
A-matrix is not a row-matrix!"]; Print["Switching to the Conic Hull Method."]; 
              MBConicHulls`Private`ResolveMBOut = 
               MBConicHulls`ResolveMB[
                MBConicHulls`Private`MBRepIn, MBConicHulls`MaxSolutions -> 
                 MBConicHulls`Private`MaxSol, MBConicHulls`MBNumber -> 
                 OptionValue[MBConicHulls`MBNumber]]; 
              MBConicHulls`Private`BreakTri = True; 
              Return[MBConicHulls`Private`ResolveMBOut]; Null]; 
            If[MBConicHulls`Private`QSolve, MBConicHulls`Private`TPCommand = 
              "points2placingtriang", {
                MBConicHulls`Private`RetTup, MBConicHulls`Private`Comb, 
                 MBConicHulls`Private`Poles, MBConicHulls`Private`R, 
                 MBConicHulls`Private`B, MBConicHulls`Private`NumDenIntCof, 
                 MBConicHulls`Private`Degenerate, MBConicHulls`Private`RR, 
                 MBConicHulls`Private`Msg1, MBConicHulls`Private`SGN} = 
               MBConicHulls`Private`FindAllGoodComb[
                MBConicHulls`Private`MBRepVars, 
                 OptionValue[MBConicHulls`RunInParallel]]; 
              Print[MBConicHulls`Private`Msg1]; 
              MBConicHulls`Private`TPCommand = "points2alltriangs"; Null]; 
            MBConicHulls`Private`A = Transpose[MBConicHulls`Private`A]; 
            PrintTemporary["Running Topcom"]; If[
              And[
               Or[
               Head[MBConicHulls`Private`Card] === Integer, 
                Head[MBConicHulls`Private`MaxCard] === Integer], 
               Not[MBConicHulls`Private`RegOnly]], 
              Print["Cannot set cardinality or maxcardinality for non-regular \
triangulations!"]; Abort[]]; If[
              And[
              Head[MBConicHulls`Private`Card] === Integer, 
               Head[MBConicHulls`Private`MaxCard] === Integer], 
              Print["Cannot set cardinality and maxcardinality \
simultaneously!"]; Abort[]]; 
            If[MBConicHulls`Private`RegOnly, 
              MBConicHulls`Private`TopComOptions = 
              MBConicHulls`Private`TopComOptions <> " --regular", 
              MBConicHulls`Private`TopComOptions = 
               MBConicHulls`Private`TopComOptions <> " --nonregular"; 
              MBConicHulls`Private`RegMsg = "non-regular"]; If[
              OptionValue[MBConicHulls`TopComParallel], 
              MBConicHulls`Private`TopComOptions = 
              MBConicHulls`Private`TopComOptions <> 
               " --parallelenumeration --workbuffercontrol"]; If[
              And[
              Head[MBConicHulls`Private`Card] === Integer, 
               MBConicHulls`Private`RegOnly], 
              MBConicHulls`Private`RequestCard = True; 
              MBConicHulls`Private`TopComOptions = 
               MBConicHulls`Private`TopComOptions <> " --cardinality " <> 
                ToString[MBConicHulls`Private`Card]; 
              MBConicHulls`Private`CardMsg = 
               " with cardinality " <> ToString[MBConicHulls`Private`Card]]; 
            If[
              And[
              Head[MBConicHulls`Private`MaxCard] === Integer, 
               MBConicHulls`Private`RegOnly], 
              MBConicHulls`Private`RequestMaxCard = True; 
              MBConicHulls`Private`TopComOptions = 
               MBConicHulls`Private`TopComOptions <> " --maxcardinality " <> 
                ToString[MBConicHulls`Private`MaxCard]; 
              MBConicHulls`Private`CardMsg = 
               " with maximum cardinality " <> 
                ToString[MBConicHulls`Private`MaxCard]]; 
            If[MBConicHulls`Private`RequestCard, 
              PrintTemporary["Checking Cardinality"]]; 
            If[MBConicHulls`Private`RequestMaxCard, 
              PrintTemporary["Checking MaxCardinality"]]; 
            While[Length[MBConicHulls`Private`AllTriangulations] === 0, 
              MBConicHulls`Private`AllTriangulations = 
               MBConicHulls`Private`FindTriangulations[MBConicHulls`Private`A, 
                 OptionValue[MBConicHulls`TopComPath], 
                 MBConicHulls`Private`TopComOptions, 
                 MBConicHulls`Private`MaxRequestedSeries, 
                 MBConicHulls`Private`CardMsg, 
                 MBConicHulls`Private`TPCommand]; Null]; 
            PrintTemporary["Done!"]; PrintTemporary["Sorting Triangulations"]; 
            MBConicHulls`Private`AllTriangulations = 
             Sort[MBConicHulls`Private`AllTriangulations, Length[#] < 
               Length[#2]& ]; PrintTemporary["Done!"]; Print["Found ", 
              Length[MBConicHulls`Private`AllTriangulations], " " <> 
              MBConicHulls`Private`RegMsg <> " triangulations" <> 
              MBConicHulls`Private`CardMsg <> "."]; 
            If[MBConicHulls`Private`ShortOnly, 
              MBConicHulls`Private`AllTriangulations = 
              Part[MBConicHulls`Private`AllTriangulations, {1}]]; If[
              And[
               Not[MBConicHulls`Private`RequestCard], 
               Not[MBConicHulls`Private`QSolve]], 
              Print["The shortest series solution found is of length ", 
               Length[
                First[MBConicHulls`Private`AllTriangulations]], "."]]; 
            If[MBConicHulls`Private`QSolve, 
              Print["Solution found of length ", 
               Length[
                First[MBConicHulls`Private`AllTriangulations]], "."]]; 
            MBConicHulls`Private`LengthList = 
             Map[Length[#]& , MBConicHulls`Private`AllTriangulations]; 
            MBConicHulls`Private`LengthTally = 
             Tally[MBConicHulls`Private`LengthList]; 
            Do[MBConicHulls`Private`LengthMessage = 
              MBConicHulls`Private`LengthMessage <> "Cardinality " <> ToString[
                 Part[
                  Part[
                  MBConicHulls`Private`LengthTally, MBConicHulls`Private`i], 
                  1]] <> ":: Solution found " <> ToString[
                 Part[
                  Part[
                  MBConicHulls`Private`LengthTally, MBConicHulls`Private`i], 
                  2]] <> ".\n", {MBConicHulls`Private`i, 
               Length[MBConicHulls`Private`LengthTally]}]; If[
              Not[MBConicHulls`Private`RequestCard], 
              Print[MBConicHulls`Private`LengthMessage]]; 
            If[MBConicHulls`Private`QSolve, 
              PrintTemporary["Deriving associated poles."]; 
              MBConicHulls`Private`Comb = Sort[
                 Map[Complement[
                   Range[MBConicHulls`Private`NumLength], #]& , 
                  Part[MBConicHulls`Private`AllTriangulations, 1]]]; 
              MBConicHulls`Private`RR = Map[MBConicHulls`Private`x, 
                 Range[
                  MBConicHulls`Private`MBRepDim[
                  MBConicHulls`Private`MBRepVarsFlatten]]]; 
              Monitor[Do[
                 MBConicHulls`Private`SGN = Insert[MBConicHulls`Private`SGN, 
                    Sign[
                    Det[
                    Map[Extract[
                    Rest[MBConicHulls`Private`Cof], #]& , 
                    MBConicHulls`Private`i]]], MBConicHulls`Private`RetTup]; 
                  If[MBConicHulls`Private`MSeries, 
                    MBConicHulls`Private`ConHull = 
                    Insert[MBConicHulls`Private`ConHull, 
                    ConicHullRegion[{
                    Part[MBConicHulls`Private`Cof, 1]}, 
                    Map[Extract[
                    Rest[MBConicHulls`Private`Cof], #]& , 
                    MBConicHulls`Private`i]], MBConicHulls`Private`RetTup]; 
                    MBConicHulls`Private`B = Insert[MBConicHulls`Private`B, 
                    ReplaceAll[
                    Refine[
                    RegionMember[
                    Part[MBConicHulls`Private`ConHull, 
                    MBConicHulls`Private`RetTup], MBConicHulls`Private`RR], 
                    Element[MBConicHulls`Private`RR, Reals]], {
                    GreaterEqual -> Greater, LessEqual -> Less}], 
                    MBConicHulls`Private`RetTup]; 
                    MBConicHulls`Private`R = Insert[MBConicHulls`Private`R, 
                    ImplicitRegion[
                    Part[MBConicHulls`Private`B, MBConicHulls`Private`RetTup], 
                    Evaluate[MBConicHulls`Private`RR]], 
                    MBConicHulls`Private`RetTup]; Null, 
                    MBConicHulls`Private`ConHull = {}; 
                    MBConicHulls`Private`B = {}; MBConicHulls`Private`R = {}]; 
                  MBConicHulls`Private`j = 1; 
                  MBConicHulls`Private`Poles = 
                   Insert[MBConicHulls`Private`Poles, 
                    Flatten[
                    ReplaceAll[MBConicHulls`Private`IntVar, 
                    Solve[
                    Map[
                    Apply[And, {
                    Part[MBConicHulls`Private`NumFlat, #] == -
                    Subscript[MBConicHulls`n, 
                    Increment[MBConicHulls`Private`j]]}]& , 
                    MBConicHulls`Private`i], MBConicHulls`Private`IntVar]]], 
                    MBConicHulls`Private`RetTup]; 
                  Increment[MBConicHulls`Private`RetTup], {
                  MBConicHulls`Private`i, MBConicHulls`Private`Comb}]; Null, 
                ProgressIndicator[
                 Part[
                  Flatten[
                   Position[
                   MBConicHulls`Private`Comb, MBConicHulls`Private`i]], 1], {
                 1, 
                  Length[MBConicHulls`Private`Comb]}]]; 
              MBConicHulls`Private`Cof = Rest[
                 MBConicHulls`Private`MakeCof[
                 MBConicHulls`Private`MBRepVarsGamma]]; 
              MBConicHulls`Private`NumGammaCof = 
               Map[Dot[MBConicHulls`Private`IntVar, 
                  Part[MBConicHulls`Private`Cof, #]]& , 
                 Range[
                  Length[MBConicHulls`Private`NumGamma]]]; 
              MBConicHulls`Private`DenGammaCof = 
               Map[Dot[MBConicHulls`Private`IntVar, 
                  Part[MBConicHulls`Private`Cof, #]]& , 
                 Range[Length[MBConicHulls`Private`NumGamma] + 1, 
                  Length[MBConicHulls`Private`Cof]]]; 
              MBConicHulls`Private`NumDenIntGammaCof = 
               Join[MBConicHulls`Private`NumGammaCof, -
                 MBConicHulls`Private`DenGammaCof]; 
              MBConicHulls`Private`NumDenIntCof = (
                MBConicHulls`Private`NumDenIntGammaCof = 
                Join[MBConicHulls`Private`NumGammaCof, -
                  MBConicHulls`Private`DenGammaCof]); 
              MBConicHulls`Private`Delta = 
               Total[MBConicHulls`Private`NumDenIntGammaCof]; 
              MBConicHulls`Private`ProportionalQ[
                 Pattern[MBConicHulls`Private`x1, 
                  Blank[]], 
                 Pattern[MBConicHulls`Private`y1, 
                  Blank[]]] := 
               With[{MBConicHulls`Private`x = 
                  Coefficient[
                   MBConicHulls`Private`x1, MBConicHulls`Private`IntVar], 
                  MBConicHulls`Private`y = 
                  Coefficient[
                   MBConicHulls`Private`y1, MBConicHulls`Private`IntVar]}, 
                 If[
                 Dot[MBConicHulls`Private`x, MBConicHulls`Private`y]/(
                   Norm[MBConicHulls`Private`x] Norm[MBConicHulls`Private`y]) === 
                  1, 
                  Return[True], 
                  Return[False]]]; 
              Which[FullSimplify[MBConicHulls`Private`Delta] === 0, 
                MBConicHulls`Private`Degenerate = True; 
                MBConicHulls`Private`Msg1 = StringForm["Degenerate case"], 
                MBConicHulls`Private`AnyProportionalQ = Catch[Do[
                    If[
                    MBConicHulls`Private`ProportionalQ[
                    MBConicHulls`Private`Delta, MBConicHulls`Private`i], 
                    Throw[True], 
                    Continue[]], {
                    MBConicHulls`Private`i, MBConicHulls`Private`NumCof}]; 
                   Throw[False]]; MBConicHulls`Private`AnyProportionalQ, 
                MBConicHulls`Private`Degenerate = False; 
                MBConicHulls`Private`Msg1 = 
                 StringForm[
                  "Degenerate case with \[CapitalDelta] proportional to one \
or more coefficient vectors"], True, MBConicHulls`Private`Degenerate = False; 
                MBConicHulls`Private`Msg1 = 
                 StringForm["Non-Degenerate case"]]; 
              Print[MBConicHulls`Private`Msg1]; PrintTemporary["Done!"]; 
              Null]; PrintTemporary["Rearranging Triangulations"]; If[
              Not[MBConicHulls`Private`SolSummary], 
              MBConicHulls`Private`Triangulation = 
               With[{MBConicHulls`Private`CombIdx = Map[First, 
                    PositionIndex[MBConicHulls`Private`Comb]], 
                  MBConicHulls`Private`NumLengthW = 
                  MBConicHulls`Private`NumLength}, 
                 Sort[
                  Table[
                   Sort[
                    Map[MBConicHulls`Private`CombIdx[
                    Complement[
                    Range[MBConicHulls`Private`NumLengthW], #]]& , 
                    Part[
                    MBConicHulls`Private`AllTriangulations, 
                    MBConicHulls`Private`i]]], {MBConicHulls`Private`i, 
                    Length[MBConicHulls`Private`AllTriangulations]}]]]; Null]; 
            PrintTemporary["Done!"]; If[
              And[MBConicHulls`Private`MSeries, 
               Not[MBConicHulls`Private`SolSummary], 
               MBConicHulls`Private`Degenerate], 
              PrintTemporary["Finding Masters Series"]; 
              MBConicHulls`Private`TriConeRows = 
               Map[MBConicHulls`Private`MBCHFastIntersection[#, 
                  MBConicHulls`Private`RR, "Rows"]& , MBConicHulls`Private`B]; 
              Do[MBConicHulls`Private`Labels = 
                 Part[MBConicHulls`Private`Triangulation, 
                   MBConicHulls`Private`k]; Which[
                  And[
                  MBConicHulls`Private`Degenerate, MBConicHulls`Private`Dim >= 
                   2], MBConicHulls`Private`MasterCH = 
                   Insert[MBConicHulls`Private`MasterCH, 
                    MBConicHulls`Private`MBCHFastIntersection[
                    Part[MBConicHulls`Private`B, MBConicHulls`Private`Labels],
                     MBConicHulls`Private`RR, 
                    Apply[Join, 
                    Part[
                    MBConicHulls`Private`TriConeRows, 
                    MBConicHulls`Private`Labels]]], -1]; 
                  MBConicHulls`Private`MasterCHNorVec = 
                   Insert[MBConicHulls`Private`MasterCHNorVec, 
                    MBConicHulls`Private`temp = 
                    Part[MBConicHulls`Private`MasterCH, 
                    MBConicHulls`Private`k]; Table[
                    Coefficient[
                    Apply[Subtract, 
                    Part[MBConicHulls`Private`temp, MBConicHulls`Private`i]], 
                    Evaluate[MBConicHulls`Private`RR]], {
                    MBConicHulls`Private`i, 
                    Length[MBConicHulls`Private`temp]}], -1]; 
                  MBConicHulls`Private`LMasterCHNorVec = Sort[
                    Last[MBConicHulls`Private`MasterCHNorVec]]; 
                  If[Length[MBConicHulls`Private`temp] > 
                    MBConicHulls`Private`Dim, 
                    MBConicHulls`Private`MasterCHNorVec = 
                    ReplacePart[
                    MBConicHulls`Private`MasterCHNorVec, -1 -> 
                    Part[MBConicHulls`Private`LMasterCHNorVec, 
                    Flatten[
                    Map[Position[#, 
                    Except[0, 
                    PatternTest[
                    Blank[], NumericQ]], 1, 1]& , 
                    Last[
                    QRDecomposition[
                    Transpose[MBConicHulls`Private`LMasterCHNorVec]]]]]]]]; 
                  MBConicHulls`Private`MasterCHBasVec = 
                   Insert[MBConicHulls`Private`MasterCHBasVec, 
                    Table[MBConicHulls`Private`CrossProd = Apply[Cross, 
                    Part[
                    Part[
                    MBConicHulls`Private`MasterCHNorVec, 
                    MBConicHulls`Private`k], MBConicHulls`Private`i]]; If[
                    ReplaceAll[
                    Part[
                    Part[
                    MBConicHulls`Private`MasterCH, MBConicHulls`Private`k], 
                    Complement[
                    Range[MBConicHulls`Private`Dim], MBConicHulls`Private`i]], 
                    Map[
                    Part[MBConicHulls`Private`RR, #] -> 
                    Part[MBConicHulls`Private`CrossProd, #]& , 
                    Range[MBConicHulls`Private`Dim]]], 
                    MBConicHulls`Private`CrossProd, -
                    MBConicHulls`Private`CrossProd], {
                    MBConicHulls`Private`i, 
                    MBConicHulls`Private`AllPosSub}], -1]; 
                  MBConicHulls`Private`j = 1; 
                  MBConicHulls`Private`MasterPoles = 
                   Insert[MBConicHulls`Private`MasterPoles, 
                    Flatten[
                    Solve[
                    Apply[And, 
                    Table[Dot[MBConicHulls`Private`IntVar, 
                    Part[
                    Part[
                    MBConicHulls`Private`MasterCHBasVec, 
                    MBConicHulls`Private`k], MBConicHulls`Private`i]] == -
                    Subscript[MBConicHulls`n, 
                    Increment[MBConicHulls`Private`j]], {
                    MBConicHulls`Private`i, MBConicHulls`Private`Dim}]], 
                    MBConicHulls`Private`IntVar]], -1]; 
                  MBConicHulls`Private`MasterCharList = 
                   Insert[MBConicHulls`Private`MasterCharList, 
                    Join[
                    ReplaceAll[MBConicHulls`Private`NumDenIntCof, 
                    Part[
                    MBConicHulls`Private`MasterPoles, 
                    MBConicHulls`Private`k]], 
                    Map[Subscript[MBConicHulls`n, #]& , 
                    Range[MBConicHulls`Private`Dim]]], -1]; 
                  MBConicHulls`Private`RepeatedTermLabel = {}; Do[If[
                    Or[
                    MemberQ[
                    MBConicHulls`Private`RepeatedTermLabel, 
                    MBConicHulls`Private`i], 
                    MemberQ[
                    MBConicHulls`Private`RepeatedTermLabel, 
                    MBConicHulls`Private`j]], 
                    Continue[]]; If[FullSimplify[
                    Total[
                    Part[
                    Part[
                    MBConicHulls`Private`MasterCharList, 
                    MBConicHulls`Private`k], {
                    MBConicHulls`Private`i, MBConicHulls`Private`j}]]] === 0, 
                    MBConicHulls`Private`RepeatedTermLabel = 
                    Union[MBConicHulls`Private`RepeatedTermLabel, {
                    MBConicHulls`Private`i, MBConicHulls`Private`j}]], {
                    MBConicHulls`Private`i, 1, Length[
                    Part[
                    MBConicHulls`Private`MasterCharList, 
                    MBConicHulls`Private`k]] - 1}, {
                    MBConicHulls`Private`j, MBConicHulls`Private`i + 1, 
                    Length[
                    Part[
                    MBConicHulls`Private`MasterCharList, 
                    MBConicHulls`Private`k]]}]; 
                  Part[MBConicHulls`Private`MasterCharList, 
                    MBConicHulls`Private`k] = FullSimplify[
                    Delete[
                    Part[
                    MBConicHulls`Private`MasterCharList, 
                    MBConicHulls`Private`k], 
                    Table[{
                    Part[
                    MBConicHulls`Private`RepeatedTermLabel, 
                    MBConicHulls`Private`i]}, {MBConicHulls`Private`i, 
                    Length[MBConicHulls`Private`RepeatedTermLabel]}]]]; 
                  MBConicHulls`Private`MasterSeriesVar = 
                   Insert[MBConicHulls`Private`MasterSeriesVar, 
                    Table[
                    Apply[
                    Times, MBConicHulls`Private`MBVar[
                    MBConicHulls`Private`MBRepVarsFlatten]^Coefficient[
                    ReplaceAll[MBConicHulls`Private`IntVar, 
                    Part[
                    MBConicHulls`Private`MasterPoles, 
                    MBConicHulls`Private`k]], 
                    Subscript[MBConicHulls`n, MBConicHulls`Private`i]]], {
                    MBConicHulls`Private`i, MBConicHulls`Private`Dim}], -1]; 
                  MBConicHulls`Private`MasterSeriesMsg = 
                   Append[MBConicHulls`Private`MasterSeriesMsg, 
                    StringForm[
                    " with master series characteristic list and variables \
`1`.", 
                    Join[{
                    Part[
                    MBConicHulls`Private`MasterCharList, 
                    MBConicHulls`Private`k]}, {
                    Part[
                    MBConicHulls`Private`MasterSeriesVar, 
                    MBConicHulls`Private`k]}]]], 
                  And[
                  MBConicHulls`Private`Degenerate, MBConicHulls`Private`Dim === 
                   1], MBConicHulls`Private`MasterCharList = 
                   Insert[MBConicHulls`Private`MasterCharList, 
                    Subscript[MBConicHulls`n, 1], -1]; If[
                    ContainsOnly[
                    Part[
                    MBConicHulls`Private`SGN, 
                    MBConicHulls`Private`Labels], {-1}], 
                    MBConicHulls`Private`MasterSeriesVar = 
                    Insert[MBConicHulls`Private`MasterSeriesVar, 
                    MBConicHulls`Private`MBVar[
                    MBConicHulls`Private`MBRepVarsFlatten], -1], 
                    MBConicHulls`Private`MasterSeriesVar = 
                    Insert[MBConicHulls`Private`MasterSeriesVar, 1/
                    MBConicHulls`Private`MBVar[
                    MBConicHulls`Private`MBRepVarsFlatten], -1]]; 
                  MBConicHulls`Private`MasterSeriesMsg = 
                   Append[MBConicHulls`Private`MasterSeriesMsg, 
                    StringForm[
                    "with master series characteristic list and variables \
`1`.", 
                    Join[{
                    Part[
                    MBConicHulls`Private`MasterCharList, 
                    MBConicHulls`Private`k]}, {
                    Part[
                    MBConicHulls`Private`MasterSeriesVar, 
                    MBConicHulls`Private`k]}]]]]; Null, {
                MBConicHulls`Private`k, 
                 Length[MBConicHulls`Private`Triangulation]}], 
              MBConicHulls`Private`MasterSeriesMsg = ConstantArray[".", 
                Length[MBConicHulls`Private`Triangulation]]]; 
            If[MBConicHulls`Private`PrintSol, Do[
                AppendTo[MBConicHulls`Private`Msg2, 
                 StringForm[
                 "\!\(\*StyleBox[\"Series\",FontWeight->\"Bold\"]\)\!\(\*\
StyleBox[\" \
\",FontWeight->\"Bold\"]\)\!\(\*StyleBox[\"Solution\",FontWeight->\"Bold\"]\) \
`1` :: Cardinality `2`. Set of poles :: `3`", MBConicHulls`Private`i, 
                  Length[
                   Part[
                   MBConicHulls`Private`Triangulation, 
                    MBConicHulls`Private`i]], 
                  Map[Expand[
                    Part[MBConicHulls`Private`Poles, #]]& , 
                   Part[
                   MBConicHulls`Private`Triangulation, 
                    MBConicHulls`Private`i]]]], {MBConicHulls`Private`i, 
                 Length[MBConicHulls`Private`Triangulation]}]; Do[Print[
                  Part[MBConicHulls`Private`Msg2, MBConicHulls`Private`i], 
                  Part[
                  MBConicHulls`Private`MasterSeriesMsg, 
                   MBConicHulls`Private`i]]; Print[""], {
                MBConicHulls`Private`i, 
                 Length[MBConicHulls`Private`Msg2]}]]; Null]; 
         If[MBConicHulls`Private`BreakTri, 
           Return[MBConicHulls`Private`ResolveMBOut]]; Print["Time Taken ", 
           Part[MBConicHulls`Private`TimeTaken, 1], " seconds"]; 
         Return[{MBConicHulls`Private`Triangulation, 
            MBConicHulls`Private`Comb, MBConicHulls`Private`Poles, {}, {}, 
            MBConicHulls`Private`SGN, 
            Length[MBConicHulls`Private`Triangulation], 
            MBConicHulls`Private`MBRepVars, MBConicHulls`Private`R, 
            MBConicHulls`Private`RetTup, MBConicHulls`Private`B, 
            MBConicHulls`Private`MasterCharList, 
            MBConicHulls`Private`MasterSeriesVar, 
            MBConicHulls`Private`DumVar}]]}], "SubValues" -> None, 
    "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> {
     MBConicHulls`MasterSeries -> True, MBConicHulls`MaxSolutions -> 
      DirectedInfinity[1], MBConicHulls`PrintSolutions -> True, 
      MBConicHulls`ShortestOnly -> False, MBConicHulls`TopComPath -> 
      "/usr/local/bin/", MBConicHulls`TopComParallel -> True, 
      MBConicHulls`Cardinality -> None, MBConicHulls`MaxCardinality -> None, 
      MBConicHulls`SolutionSummary -> False, MBConicHulls`QuickSolve -> False,
       MBConicHulls`MBNumber -> 1, MBConicHulls`RunInParallel -> True}, 
    "Attributes" -> {}, "FullName" -> "MBConicHulls`TriangulateMB"|>, 
   False]]], "Output",
 CellChangeTimes->{
  3.898615738834589*^9, 3.898754679808947*^9, {3.899203700994081*^9, 
   3.899203714002681*^9}, 3.8992051938544064`*^9, 3.899378374223011*^9, 
