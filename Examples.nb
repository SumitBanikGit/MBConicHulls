          MBConicHulls`Private`MBRepVars, 
          MBConicHulls`Private`MaxRequestedSeries = 
          OptionValue[MBConicHulls`MaxSolutions], 
          MBConicHulls`Private`TimeTaken, MBConicHulls`Private`TopComOptions = 
