              Print["The number of Integration variables and MB variables \
should be same."]; Abort[]; Null]; If[Length[
                 Flatten[
                  Part[MBConicHulls`Private`MBArgNew, 2]]] - Length[
                Part[MBConicHulls`Private`MBArgNew, 2]] =!= 0, 
              Print["PolyGamma in the denominator is not supported."]; 
              Abort[]; Null]; Which[
              ContainsOnly[
