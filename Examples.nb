Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PropagatorSubNonResHX", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"b", "\[Rule]", 
       RowBox[{"85", "/", "100"}]}], ",", 
      RowBox[{"c", "\[Rule]", 
       RowBox[{"47", "/", "100"}]}], ",", 
      RowBox[{"d", "\[Rule]", 
       RowBox[{"135", "/", "100"}]}], ",", 
      RowBox[{"e", "\[Rule]", 
       RowBox[{"68", "/", "100"}]}], ",", 
      RowBox[{"f", "\[Rule]", 
       RowBox[{"89", "/", "100"}]}]}], "}"}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SeriesNumberHX", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EvaluateSeriesNonResHXOut", "=", 
   RowBox[{"EvaluateSeries", "[", 
    RowBox[{"ResolveMBHXOut", ",", 
     RowBox[{"Join", "[", 
      RowBox[{"PropagatorSubNonResHX", ",", "MBVarHXConvert"}], "]"}], ",", 
     "SeriesNumberHX", ",", 
     RowBox[{"PrintSeries", "->", "True"}]}], "]"}]}], ";"}]}], "Input",
