                    Map[Range[0, #]& , MBConicHulls`Private`LList]]; 
                 MBConicHulls`Private`GoodPts = Pick[MBConicHulls`Private`Pts, 
                    Map[TrueQ, 
                    MapApply[
                    MBConicHulls`Private`CondFn, MBConicHulls`Private`Pts]]]; 
                 If[MBConicHulls`Private`GoodPts === {}, 
                   If[MBConicHulls`Private`Prec === MachinePrecision, 0., 0], 
                   If[MBConicHulls`Private`Prec =!= MachinePrecision, 
                    Total[
                    Map[
                    Function[MBConicHulls`Private`pt, 
                    Module[{MBConicHulls`Private`v = Quiet[
                    N[
                    ReplaceAll[MBConicHulls`Private`TermIn, 
                    Thread[Map[Subscript[MBConicHulls`n, #]& , 
                    Range[MBConicHulls`Private`DimVal]] -> 
                    MBConicHulls`Private`pt]], MBConicHulls`Private`Prec]]}, 
                    If[
                    MBConicHulls`Private`OkQ[MBConicHulls`Private`v], 
                    MBConicHulls`Private`v, 0]]], 
                    MBConicHulls`Private`GoodPts]], 
                    MBConicHulls`Private`NVecs = 
                    Transpose[MBConicHulls`Private`GoodPts]; 
                    MBConicHulls`Private`VarSub = 
                    Thread[MBConicHulls`Private`VarSyms -> 
                    MBConicHulls`Private`NVecs]; 
                    MBConicHulls`Private`SpFns = DeleteDuplicates[
                    Cases[MBConicHulls`Private`TermW, 
                    Alternatives[
                    Condition[
                    Gamma[
                    Pattern[MBConicHulls`Private`a, 
                    Blank[]]], 
                    Not[
                    FreeQ[
                    MBConicHulls`Private`a, MBConicHulls`Private`VarPat]]], 
                    Condition[
                    PolyGamma[
                    Blank[], 
                    Pattern[MBConicHulls`Private`a, 
                    Blank[]]], 
                    Not[
                    FreeQ[
                    MBConicHulls`Private`a, MBConicHulls`Private`VarPat]]], 
                    Condition[Pattern[MBConicHulls`Private`b, 
                    Blank[]]^Pattern[MBConicHulls`Private`e, 
                    Blank[]], 
                    And[
                    FreeQ[
                    MBConicHulls`Private`b, MBConicHulls`Private`VarPat], 
                    Not[
                    FreeQ[
                    MBConicHulls`Private`e, 
                    MBConicHulls`Private`VarPat]]]]], {0, Infinity}]]; 
                    MBConicHulls`Private`Args = DeleteDuplicates[
                    Join[
                    Cases[MBConicHulls`Private`SpFns, Gamma[
                    Pattern[MBConicHulls`Private`a, 
                    Blank[]]] :> MBConicHulls`Private`a, {1}], 
                    Cases[MBConicHulls`Private`SpFns, PolyGamma[
                    Blank[], 
                    Pattern[MBConicHulls`Private`a, 
                    Blank[]]] :> MBConicHulls`Private`a, {1}]]]; 
                    MBConicHulls`Private`ArgVals = 
                    AssociationThread[MBConicHulls`Private`Args -> Map[N[
                    ReplaceAll[#, MBConicHulls`Private`VarSub], 
                    MBConicHulls`Private`Prec]& , MBConicHulls`Private`Args]]; 
                    MBConicHulls`Private`SpSlots = Table[
                    Unique["MBsp"], {
                    Length[MBConicHulls`Private`SpFns]}]; 
                    MBConicHulls`Private`BodyW = N[
                    ReplaceAll[MBConicHulls`Private`TermW, 
                    Thread[
                    MBConicHulls`Private`SpFns -> 
                    MBConicHulls`Private`SpSlots]], 
                    MBConicHulls`Private`Prec]; 
                    MBConicHulls`Private`BodyFn = Function[
                    Evaluate[
                    Join[
                    MBConicHulls`Private`VarSyms, 
                    MBConicHulls`Private`SpSlots]], 
                    Evaluate[MBConicHulls`Private`BodyW]]; 
                    MBConicHulls`Private`SpVals = Map[
                    Function[MBConicHulls`Private`s, 
                    Switch[
                    Head[MBConicHulls`Private`s], Gamma, 
                    Gamma[
                    MBConicHulls`Private`ArgVals[
                    Part[MBConicHulls`Private`s, 1]]], PolyGamma, 
                    PolyGamma[
                    Part[MBConicHulls`Private`s, 1], 
                    MBConicHulls`Private`ArgVals[
                    Part[MBConicHulls`Private`s, 2]]], Power, 
                    MBConicHulls`Private`PowerVals[
                    Part[MBConicHulls`Private`s, 1], 
                    ReplaceAll[
                    Part[MBConicHulls`Private`s, 2], 
                    MBConicHulls`Private`VarSub], 
                    MBConicHulls`Private`Prec]]], MBConicHulls`Private`SpFns]; 
                    MBConicHulls`Private`Res = Quiet[
                    Apply[MBConicHulls`Private`BodyFn, 
                    Join[
                    MBConicHulls`Private`NVecs, 
                    MBConicHulls`Private`SpVals]]]; If[
                    ListQ[MBConicHulls`Private`Res], 
                    If[
                    Developer`PackedArrayQ[MBConicHulls`Private`Res], 
                    Total[MBConicHulls`Private`Res], 
                    Module[{MBConicHulls`Private`bad = Flatten[
                    Position[MBConicHulls`Private`Res, 
                    Condition[
                    Pattern[MBConicHulls`Private`x, 
                    Blank[]], 
                    Not[
                    MBConicHulls`Private`OkQ[MBConicHulls`Private`x]]], {1}, 
                    Heads -> False]]}, 
                    If[MBConicHulls`Private`bad =!= {}, 
                    Part[MBConicHulls`Private`Res, MBConicHulls`Private`bad] = 
                    Map[
                    Function[MBConicHulls`Private`ix, 
                    Module[{MBConicHulls`Private`v = Quiet[
                    N[
                    ReplaceAll[MBConicHulls`Private`TermIn, 
                    Thread[Map[Subscript[MBConicHulls`n, #]& , 
                    Range[MBConicHulls`Private`DimVal]] -> 
                    Part[MBConicHulls`Private`GoodPts, 
                    MBConicHulls`Private`ix]]], MBConicHulls`Private`Prec]]}, 
                    If[
                    MBConicHulls`Private`OkQ[MBConicHulls`Private`v], 
                    MBConicHulls`Private`v, 0.]]], MBConicHulls`Private`bad]]; 
                    Total[MBConicHulls`Private`Res]]], 
                    If[
                    MBConicHulls`Private`OkQ[MBConicHulls`Private`Res], 
                    Length[MBConicHulls`Private`GoodPts] 
                    MBConicHulls`Private`Res, 0.]]]]]]]; 
            Which[OptionValue[MBConicHulls`RunInParallel] === False, Off[
                MessageName[General, "munfl"]]; Off[
                MessageName[General, "stop"]]; 
              If[MBConicHulls`Private`TrivialQ, 
                Monitor[MBConicHulls`Private`nseries = Table[
                   MBConicHulls`Private`PieceValue[
                    Part[
                    MBConicHulls`Private`SeriesSub, MBConicHulls`Private`i], 
                    Part[
                    MBConicHulls`Private`SeriesDimList, 
                    MBConicHulls`Private`i], 
                    Part[
                    MBConicHulls`Private`LimListAll, MBConicHulls`Private`i], 
                    MBConicHulls`Private`RequestedPrecision], {
                   MBConicHulls`Private`i, 
                    MBConicHulls`Private`SeriesNumber}], 
                 ProgressIndicator[
                 MBConicHulls`Private`i, {
                  1, MBConicHulls`Private`SeriesNumber}]], 
                Monitor[MBConicHulls`Private`nseries = Table[
                   MBConicHulls`Private`PieceValueCond[
                    Part[
                    MBConicHulls`Private`SeriesSub, MBConicHulls`Private`i], 
                    Part[
                    MBConicHulls`Private`SeriesCondition, 
                    MBConicHulls`Private`i], MBConicHulls`Private`Dim, 
                    Part[
                    MBConicHulls`Private`LimListAll, MBConicHulls`Private`i], 
                    MBConicHulls`Private`RequestedPrecision], {
                   MBConicHulls`Private`i, 
                    MBConicHulls`Private`SeriesNumber}], 
                 ProgressIndicator[
                 MBConicHulls`Private`i, {
                  1, MBConicHulls`Private`SeriesNumber}]]], 
              OptionValue[MBConicHulls`RunInParallel] === True, 
              If[$KernelCount === 0, 
                LaunchKernels[]]; ParallelEvaluate[
                Off[
                 MessageName[General, "munfl"]]]; ParallelEvaluate[
                Off[
                 MessageName[General, "stop"]]]; 
              If[MBConicHulls`Private`TrivialQ, 
                MBConicHulls`Private`TaskList = Table[{
                    BinarySerialize[
                    Part[
                    MBConicHulls`Private`SeriesSub, MBConicHulls`Private`i]], 
                    Part[
                    MBConicHulls`Private`SeriesDimList, 
                    MBConicHulls`Private`i], 
                    Part[
                    MBConicHulls`Private`LimListAll, 
                    MBConicHulls`Private`i]}, {
                   MBConicHulls`Private`i, 
                    MBConicHulls`Private`SeriesNumber}]; 
                MBConicHulls`Private`TaskOrder = Reverse[
                   Ordering[
                    Table[
                    Apply[Times, 
                    Part[MBConicHulls`Private`LimListAll, 
                    MBConicHulls`Private`i] + 1] LeafCount[
                    Part[
                    MBConicHulls`Private`SeriesSub, 
                    MBConicHulls`Private`i]], {
                    MBConicHulls`Private`i, 
                    MBConicHulls`Private`SeriesNumber}]]]; 
                DistributeDefinitions[
                 MBConicHulls`Private`PieceValue, MBConicHulls`Private`OkQ]; 
                With[{MBConicHulls`Private`RP = 
                   MBConicHulls`Private`RequestedPrecision}, 
                  MBConicHulls`Private`nseries = Part[
                    ParallelMap[
                    Function[MBConicHulls`Private`t, 
                    MBConicHulls`Private`PieceValue[
                    BinaryDeserialize[
                    Part[MBConicHulls`Private`t, 1]], 
                    Part[MBConicHulls`Private`t, 2], 
                    Part[MBConicHulls`Private`t, 3], 
                    MBConicHulls`Private`RP]], 
                    Part[
                    MBConicHulls`Private`TaskList, 
                    MBConicHulls`Private`TaskOrder], Method -> 
                    "FinestGrained"], 
                    Ordering[MBConicHulls`Private`TaskOrder]]], 
                MBConicHulls`Private`TaskList = Table[{
                    BinarySerialize[
                    Part[
                    MBConicHulls`Private`SeriesSub, MBConicHulls`Private`i]], 
                    BinarySerialize[
                    Part[
                    MBConicHulls`Private`SeriesCondition, 
                    MBConicHulls`Private`i]], MBConicHulls`Private`Dim, 
                    Part[
                    MBConicHulls`Private`LimListAll, 
                    MBConicHulls`Private`i]}, {
                   MBConicHulls`Private`i, 
                    MBConicHulls`Private`SeriesNumber}]; 
                MBConicHulls`Private`TaskOrder = Reverse[
                   Ordering[
                    Table[
                    Apply[Times, 
                    Part[MBConicHulls`Private`LimListAll, 
                    MBConicHulls`Private`i] + 1] LeafCount[
                    Part[
                    MBConicHulls`Private`SeriesSub, 
                    MBConicHulls`Private`i]], {
                    MBConicHulls`Private`i, 
                    MBConicHulls`Private`SeriesNumber}]]]; 
                DistributeDefinitions[
                 MBConicHulls`Private`PieceValueCond, 
                  MBConicHulls`Private`PowerVals, MBConicHulls`Private`OkQ]; 
                With[{MBConicHulls`Private`RP = 
                   MBConicHulls`Private`RequestedPrecision}, 
                  MBConicHulls`Private`nseries = Part[
                    ParallelMap[
                    Function[MBConicHulls`Private`t, 
                    MBConicHulls`Private`PieceValueCond[
                    BinaryDeserialize[
                    Part[MBConicHulls`Private`t, 1]], 
                    BinaryDeserialize[
                    Part[MBConicHulls`Private`t, 2]], 
                    Part[MBConicHulls`Private`t, 3], 
                    Part[MBConicHulls`Private`t, 4], 
                    MBConicHulls`Private`RP]], 
                    Part[
                    MBConicHulls`Private`TaskList, 
                    MBConicHulls`Private`TaskOrder]], 
                    Ordering[MBConicHulls`Private`TaskOrder]]]]]]; 
         MBConicHulls`Private`CleanTinyImag = 
          Function[{MBConicHulls`Private`z, MBConicHulls`Private`Prec}, 
            
            Module[{MBConicHulls`Private`p, MBConicHulls`Private`tol, 
              MBConicHulls`Private`zn}, 
             MBConicHulls`Private`p = 
              If[MBConicHulls`Private`Prec === 
                MachinePrecision, $MachinePrecision, 
                MBConicHulls`Private`Prec]; 
             MBConicHulls`Private`tol = 
              10^(-Max[8, MBConicHulls`Private`p - 4]); 
             MBConicHulls`Private`zn = Quiet[
                N[MBConicHulls`Private`z, MBConicHulls`Private`Prec]]; If[
               And[
                NumberQ[MBConicHulls`Private`zn], 
                Abs[MBConicHulls`Private`zn] != 0, Abs[
                  Im[MBConicHulls`Private`zn]] <= 
                MBConicHulls`Private`tol Abs[MBConicHulls`Private`zn]], 
               Re[MBConicHulls`Private`zn], MBConicHulls`Private`zn]]]; 
         MBConicHulls`Private`FinalResult = MBConicHulls`Private`CleanTinyImag[
            Quiet[
             N[
              Total[MBConicHulls`Private`nseries], 
              OptionValue[MBConicHulls`NumericalPrecision]]], 
            OptionValue[MBConicHulls`NumericalPrecision]]; 
         Print["Numerical Result: ", MBConicHulls`Private`FinalResult]; 
         Print["Time Taken ", 
           Part[MBConicHulls`Private`TimeTaken, 1], " seconds"]; 
         Return[MBConicHulls`Private`FinalResult]]}], "SubValues" -> None, 
    "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> {
     MBConicHulls`RunInParallel -> True, MBConicHulls`NumericalPrecision -> 
      MachinePrecision, MBConicHulls`AdaptiveLimits -> False}, 
    "Attributes" -> {}, "FullName" -> "MBConicHulls`SumAllSeries"|>, 
   False]]], "Output",
