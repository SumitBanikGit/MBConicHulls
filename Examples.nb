  RowBox[{"\"\<Random Value: \>\"", ",", 
   RowBox[{"AppellMBVarSub", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SubscriptBox["u", "1"], "\[Rule]", 
