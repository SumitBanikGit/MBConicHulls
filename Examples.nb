Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "MBRep"}]], "Input",
 CellChangeTimes->{{3.828600651984914*^9, 3.828600659341439*^9}},
 CellLabel->"In[4]:=",ExpressionUUID->"b6879cf8-a869-4f34-b930-ec9b3904f68c"],

Cell[BoxData[
 InterpretationBox[
  StyleBox[
   FrameBox[
    DynamicModuleBox[{System`InformationDump`open$$ = False, 
     System`InformationDump`mouseOver$$ = False}, 
     PaneSelectorBox[{True->
      TagBox[GridBox[{
         {
          ItemBox[
           PaneBox[
            StyleBox[
             TagBox[
              TooltipBox[
               StyleBox["\<\" Symbol\"\>", "InformationRowLabel",
                StripOnInput->False],
               "\"Symbol\"",
               TooltipStyle->"TextStyling"],
              Annotation[#, "Symbol", "Tooltip"]& ], "InformationTitleText",
             StripOnInput->False,
             BaseStyle -> None],
            FrameMargins->{{4, 0}, {-1, 1}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"MBRep[PreFac_,IntVar_,MBVar_,MBArg_,MBNumber->1,\
Substitute->{},TakeLimit->{},CanonicalTransform->True,PolygammaToGamma->True] \
inputs the MB integral in a form that can be processed by the package where :\
\\nPreFac - is the prefactor of the MB integral.\\nIntVar - takes in the list \
of integration variables or the list of integration variables and their \
contour lines in case of MB with straight contours.\\nMBVar - takes in the \
list of parameters, where MBVar[[i]] is raised to the power \
IntVar[[i]].\\nMBArg - is a list of the form {{numerator},{denominator}}, \
where the elements of {numerator} and {denominator} are the arguments of the \
gamma functions in the numerator and denominator of the MB integrand, \
respectively. For polygamma functions (allowed only in the numerator), we \
input it as a list, with the first element being the order and the second \
being the argument of the function.  \\nSubstitute - is an optional parameter \
, to substitute the values of parameters appearing in the MB integrand. It is \
by default {}.\\nTakeLimit - is an optional parameter, which specifies the \
limits on parameters to be taken while transforming a straight to a \
non-straight MB. It is by default {}. \\nCanonicalTransform - is an optional \
parameter, which specifies whether to transform the input MB into a canonical \
MB. Its default value is True.\\nPolygammaToGamma - is an optional parameter, \
which specifies whether to rewrite numerator polygamma functions whose poles \
are split by straight contour as derivatives of gamma functions in the input \
MB. Its default value is True.\\n\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
         {
          PaneBox[
           TagBox[GridBox[{
              {
               StyleBox[
                TagBox[
                 TooltipBox[
                  StyleBox["\<\" Definitions\"\>", "InformationRowLabel",
                   StripOnInput->False],
                  "\"Definitions\"",
                  TooltipStyle->"TextStyling"],
                 Annotation[#, "Definitions", "Tooltip"]& ], "DialogStyle",
                StripOnInput->False]},
              {
               TemplateBox[{"\"\[ThinSpace]\"", 
                 GridBox[{{
                    RowBox[{
                    RowBox[{"MBRep", "[", 
                    
                    RowBox[{
                    "MBConicHulls`Private`PreFacRaw_", ",", 
                    "MBConicHulls`Private`IntVar_", ",", 
                    "MBConicHulls`Private`MBVar_", ",", 
                    "MBConicHulls`Private`MBArg_", ",", 
                    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"MBConicHulls`Private`MBArgNew", "=", 
                    RowBox[{
                    
                    RowBox[{"MBConicHulls`Private`RemoveCommonGamma", "[", 
                    "MBConicHulls`Private`MBArg", "]"}], "/.", 
                    "\[VeryThinSpace]", 
                    RowBox[{"OptionValue", "[", "Substitute", "]"}]}]}], ",", 
                    "MBConicHulls`Private`Contour", ",", 
                    "MBConicHulls`Private`TimeTaken", ",", 
                    "MBConicHulls`Private`IntVarNew", ",", 
                    "MBConicHulls`Private`ContourString", ",", 
                    "MBConicHulls`Private`AllVariables", ",", 
                    RowBox[{"MBConicHulls`Private`PreFac", "=", 
                    
                    RowBox[{"MBConicHulls`Private`PreFacRaw", "/.", 
                    "\[VeryThinSpace]", 
                    RowBox[{"OptionValue", "[", "Substitute", "]"}]}]}], ",", 
                    "MBConicHulls`Private`STNSReturn", ",", 
                    "MBConicHulls`Private`RetTup", ",", 
                    "MBConicHulls`Private`Comb", ",", 
                    "MBConicHulls`Private`Poles", ",", 
                    "MBConicHulls`Private`R", ",", "MBConicHulls`Private`B", 
                    ",", "MBConicHulls`Private`NumDenIntCof", ",", 
                    "MBConicHulls`Private`Degenerate", ",", 
                    "MBConicHulls`Private`RR", ",", 
                    "MBConicHulls`Private`Msg1", ",", 
                    "MBConicHulls`Private`SGN", ",", 
                    "MBConicHulls`Private`Num", ",", 
                    "MBConicHulls`Private`IntVarPos", ",", 
                    "MBConicHulls`Private`NewPos", ",", 
                    "MBConicHulls`Private`MBNumArg", ",", 
                    "MBConicHulls`Private`ContourSub", ",", 
                    RowBox[{"MBConicHulls`Private`DumVar", "=", 
                    RowBox[{"{", "}"}]}], ",", 
                    "MBConicHulls`Private`TakeLimitAll", ",", 
                    "MBConicHulls`Private`MBDenArg", ",", 
                    "MBConicHulls`Private`DumVarOnly"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"MBConicHulls`Private`TimeTaken", "=", 
                    RowBox[{"AbsoluteTiming", "[", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    
                    RowBox[{"Length", "[", "MBConicHulls`Private`IntVar", 
                    "]"}], "=!=", 
                    
                    RowBox[{"Length", "[", "MBConicHulls`Private`MBVar", 
                    "]"}]}], ",", 
                    RowBox[{
                    
                    RowBox[{"Print", "[", 
                    "\"The number of Integration variables and MB variables \
should be same.\"", "]"}], ";", 
                    RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", 
                    RowBox[{"Flatten", "[", 
                    
                    RowBox[{"MBConicHulls`Private`MBArgNew", 
                    "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                    "]"}], "]"}], "-", 
                    RowBox[{"Length", "[", 
                    
                    RowBox[{"MBConicHulls`Private`MBArgNew", 
                    "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
                    "]"}]}], "=!=", "0"}], ",", 
                    RowBox[{
                    
                    RowBox[{"Print", "[", 
                    "\"PolyGamma in the denominator is not supported.\"", 
                    "]"}], ";", 
                    RowBox[{"Abort", "[", "]"}], ";"}]}], "]"}], ";", 
                    RowBox[{"Which", "[", 
                    RowBox[{
                    RowBox[{"ContainsOnly", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Head", "[", "#1", "]"}], "&"}], ")"}], "/@", 
                    "MBConicHulls`Private`IntVar"}], ",", 
                    RowBox[{"{", "Rule", "}"}]}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"MBConicHulls`Private`IntVarNew", "=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"First", "[", "#1", "]"}], "&"}], ")"}], "/@", 
                    "MBConicHulls`Private`IntVar"}]}], ";", 
                    RowBox[{"MBConicHulls`Private`Contour", "=", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Last", "[", "#1", "]"}], "&"}], ")"}], "/@", 
                    "MBConicHulls`Private`IntVar"}]}], ";", 
                    RowBox[{"MBConicHulls`Private`ContourString", "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"StringJoin", "[", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"ToString", "[", 
                    RowBox[{
                    RowBox[{"Re", "[", 
                    RowBox[{"ToString", "[", 
                    RowBox[{
                    
                    RowBox[{"MBConicHulls`Private`IntVarNew", 
                    "\[LeftDoubleBracket]", "MBConicHulls`Private`i", 
                    "\[RightDoubleBracket]"}], ",", "StandardForm"}], "]"}], 
                    "]"}], ",", "StandardForm"}], "]"}], ",", "\" = \"", ",", 
                    RowBox[{"ToString", "[", 
                    RowBox[{
                    
                    RowBox[{"MBConicHulls`Private`Contour", 
                    "\[LeftDoubleBracket]", "MBConicHulls`Private`i", 
                    "\[RightDoubleBracket]"}], ",", "StandardForm"}], "]"}]}],
                     "}"}], "]"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"MBConicHulls`Private`i", ",", 
                    
                    RowBox[{"Length", "[", "MBConicHulls`Private`IntVarNew", 
                    "]"}]}], "}"}]}], "]"}]}], ";", 
                    RowBox[{"Print", "[", 
                    
                    RowBox[{"\"Straight Contour : \"", ",", 
                    "MBConicHulls`Private`ContourString"}], "]"}], ";", 
                    RowBox[{"MBConicHulls`Private`AllVariables", "=", 
                    RowBox[{"Variables", "[", 
                    RowBox[{"Flatten", "[", 
                    
                    RowBox[{"MBConicHulls`Private`MBArgNew", "/.", 
                    "\[VeryThinSpace]", 
                    RowBox[{"OptionValue", "[", "TakeLimit", "]"}]}], "]"}], 
                    "]"}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    
                    RowBox[{"Length", "[", 
                    "MBConicHulls`Private`AllVariables", "]"}], ">", 
                    
                    RowBox[{"Length", "[", "MBConicHulls`Private`IntVarNew", 
                    "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    
                    RowBox[{
                    "\"Please provide the values of the following parameters \
: \"", ",", 
                    RowBox[{"Complement", "[", 
                    
                    RowBox[{"MBConicHulls`Private`AllVariables", ",", 
                    "MBConicHulls`Private`IntVarNew"}], "]"}]}], "]"}], ";", 
                    RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"OptionValue", "[", "PolygammaToGamma", "]"}], 
                    ",", 
                    RowBox[{
                    RowBox[{"MBConicHulls`Private`MBNumArg", "=", 
                    
                    RowBox[{"MBConicHulls`Private`MBArgNew", 
                    "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
                    ";", 
                    RowBox[{"MBConicHulls`Private`MBDenArg", "=", 
                    
                    RowBox[{"MBConicHulls`Private`MBArgNew", 
                    "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
                    ";", 
                    
                    RowBox[{"MBConicHulls`Private`ContourSub", "=", 
                    "MBConicHulls`Private`IntVar"}], ";", 
                    RowBox[{"Do", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Head", "[", 
                    
                    RowBox[{"MBConicHulls`Private`MBNumArg", 
                    "\[LeftDoubleBracket]", "MBConicHulls`Private`i", 
                    "\[RightDoubleBracket]"}], "]"}], "===", "List"}], ",", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    
                    RowBox[{"MBConicHulls`Private`MBNumArg", 
                    "\[LeftDoubleBracket]", 
                    RowBox[{"MBConicHulls`Private`i", ",", "2"}], 
                    "\[RightDoubleBracket]"}], "/.", "\[VeryThinSpace]", 
                    RowBox[{"OptionValue", "[", "TakeLimit", "]"}]}], "/.", 
                    "\[VeryThinSpace]", "MBConicHulls`Private`ContourSub"}], 
                    ")"}], "<", "0"}], ",", 
                    RowBox[{
                    RowBox[{"Which", "[", 
                    RowBox[{
                    RowBox[{
                    
                    RowBox[{"MBConicHulls`Private`MBNumArg", 
                    "\[LeftDoubleBracket]", 
                    RowBox[{"MBConicHulls`Private`i", ",", "1"}], 
                    "\[RightDoubleBracket]"}], "===", "0"}], ",", 
                    RowBox[{
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"MBConicHulls`Private`MBDenArg", ",", 
                    
                    RowBox[{"MBConicHulls`Private`MBNumArg", 
                    "\[LeftDoubleBracket]", 
                    RowBox[{"MBConicHulls`Private`i", ",", "2"}], 
                    "\[RightDoubleBracket]"}]}], "]"}], ";", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"MBConicHulls`Private`DumVar", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    SubscriptBox["\[Iota]", "MBConicHulls`Private`i"], ",", 
                    "0"}], "}"}]}], "]"}], ";", 
                    RowBox[{"MBConicHulls`Private`MBNumArg", "=", 
                    RowBox[{"ReplacePart", "[", 
                    RowBox[{"MBConicHulls`Private`MBNumArg", ",", 
                    RowBox[{"{", 
                    RowBox[{"MBConicHulls`Private`i", "\[Rule]", 
                    RowBox[{
                    SubscriptBox["\[Iota]", "MBConicHulls`Private`i"], "+", 
                    
                    RowBox[{"MBConicHulls`Private`MBNumArg", 
                    "\[LeftDoubleBracket]", 
                    RowBox[{"MBConicHulls`Private`i", ",", "2"}], 
                    "\[RightDoubleBracket]"}]}]}], "}"}]}], "]"}]}]}], ",", 
                    RowBox[{
                    
                    RowBox[{"MBConicHulls`Private`MBNumArg", 
                    "\[LeftDoubleBracket]", 
                    RowBox[{"MBConicHulls`Private`i", ",", "1"}], 
                    "\[RightDoubleBracket]"}], ">", "0"}], ",", 
                    RowBox[{
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"MBConicHulls`Private`MBDenArg", ",", 
                    RowBox[{
                    
                    RowBox[{"MBConicHulls`Private`MBNumArg", 
                    "\[LeftDoubleBracket]", 
                    RowBox[{"MBConicHulls`Private`i", ",", "2"}], 
                    "\[RightDoubleBracket]"}], "+", 
                    SubscriptBox["\[Omicron]", "MBConicHulls`Private`i"]}]}], 
                    "]"}], ";", 
                    RowBox[{"AppendTo", "[", 
                    RowBox[{"MBConicHulls`Private`DumVar", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    SubscriptBox["\[Iota]", "MBConicHulls`Private`i"], ",", 
                    SubscriptBox["\[Omicron]", "MBConicHulls`Private`i"], ",", 
                    
                    RowBox[{"MBConicHulls`Private`MBNumArg", 
                    "\[LeftDoubleBracket]", 
                    RowBox[{"MBConicHulls`Private`i", ",", "1"}], 
                    "\[RightDoubleBracket]"}]}], "}"}]}], "]"}], ";", 
                    RowBox[{"MBConicHulls`Private`MBNumArg", "=", 
                    RowBox[{"ReplacePart", "[", 
                    RowBox[{"MBConicHulls`Private`MBNumArg", ",", 
                    RowBox[{"{", 
                    RowBox[{"MBConicHulls`Private`i", "\[Rule]", 
                    RowBox[{
                    SubscriptBox["\[Iota]", "MBConicHulls`Private`i"], "+", 
                    SubscriptBox["\[Omicron]", "MBConicHulls`Private`i"], "+", 
                    
                    RowBox[{"MBConicHulls`Private`MBNumArg", 
                    "\[LeftDoubleBracket]", 
                    RowBox[{"MBConicHulls`Private`i", ",", "2"}], 
                    "\[RightDoubleBracket]"}]}]}], "}"}]}], "]"}]}]}]}], 
                    "]"}], ";"}]}], "]"}], ";"}]}], "]"}], ";"}], ",", 
                    RowBox[{"{", 
                    RowBox[{"MBConicHulls`Private`i", ",", 
                    
                    RowBox[{"Length", "[", "MBConicHulls`Private`MBNumArg", 
                    "]"}]}], "}"}]}], "]"}], ";", 
                    RowBox[{"MBConicHulls`Private`MBArgNew", "=", 
                    RowBox[{"ReplacePart", "[", 
                    RowBox[{"MBConicHulls`Private`MBArgNew", ",", 
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"1", "\[Rule]", "MBConicHulls`Private`MBNumArg"}],
                     ",", 
                    RowBox[{"2", "\[Rule]", 
                    "MBConicHulls`Private`MBDenArg"}]}], "}"}]}], "]"}]}], 
                    ";", 
                    RowBox[{"MBConicHulls`Private`MBArgNew", "=", 
                    
                    RowBox[{"MBConicHulls`Private`RemoveCommonGamma", "[", 
                    "MBConicHulls`Private`MBArgNew", "]"}]}], ";"}]}], "]"}], 
                    ";", 
                    RowBox[{"MBConicHulls`Private`DumVarOnly", "=", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Most", "[", "#1", "]"}], "&"}], ")"}], "/@", 
                    "MBConicHulls`Private`DumVar"}], "]"}]}], ";", 
                    RowBox[{"MBConicHulls`Private`TakeLimitAll", "=", 
                    RowBox[{"Join", "[", 
                    RowBox[{
                    RowBox[{"OptionValue", "[", "TakeLimit", "]"}], ",", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    RowBox[{"MBConicHulls`Private`i", "\[Rule]", "0"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{"MBConicHulls`Private`i", ",", 
                    "MBConicHulls`Private`DumVarOnly"}], "}"}]}], "]"}]}], 
                    "]"}]}], ";", 
                    RowBox[{"MBConicHulls`Private`STNSReturn", "=", 
                    RowBox[{"MBConicHulls`Private`StraightToNonStraight", "[", 
                    
                    RowBox[{"MBConicHulls`Private`PreFac", ",", 
                    "MBConicHulls`Private`IntVarNew", ",", 
                    "MBConicHulls`Private`MBVar", ",", 
                    "MBConicHulls`Private`MBArgNew", ",", 
                    "MBConicHulls`Private`Contour", ",", 
                    "MBConicHulls`Private`TakeLimitAll"}], "]"}]}]}], ",", 
                    RowBox[{"ContainsNone", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{"Head", "[", "#1", "]"}], "&"}], ")"}], "/@", 
                    "MBConicHulls`Private`IntVar"}], ",", 
                    RowBox[{"{", "Rule", "}"}]}], "]"}], ",", 
                    RowBox[{
                    RowBox[{"Print", "[", "\"Non-Straight Contours.\"", "]"}],
                     ";", 
                    
                    RowBox[{"MBConicHulls`Private`IntVarNew", "=", 
                    "MBConicHulls`Private`IntVar"}], ";", 
                    RowBox[{"MBConicHulls`Private`STNSReturn", "=", 
                    RowBox[{"{", 
                    RowBox[{"{", 
                    
                    RowBox[{"MBConicHulls`Private`PreFac", ",", 
                    "MBConicHulls`Private`IntVar", ",", 
                    "MBConicHulls`Private`MBVar", ",", 
                    "MBConicHulls`Private`MBArgNew"}], "}"}], "}"}]}]}], ",", 
                    "True", ",", 
                    RowBox[{
                    
                    RowBox[{"Print", "[", 
                    "\"Input not in correct format! Please see the \
documentation.\"", "]"}], ";", 
                    RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    
                    RowBox[{"Length", "[", "MBConicHulls`Private`STNSReturn", 
                    "]"}], ">", "1"}], ",", 
                    RowBox[{"Print", "[", 
                    RowBox[{
                    
                    RowBox[{"Length", "[", "MBConicHulls`Private`STNSReturn", 
                    "]"}], ",", 
                    "\" MB integrals after transforming from straight to \
non-straight contour\""}], "]"}]}], "]"}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"OptionValue", "[", "CanonicalTransform", "]"}], 
                    ",", 
                    RowBox[{
                    
                    RowBox[{"PrintTemporary", "[", 
                    "\"Transforming into canonical form\"", "]"}], ";", 
                    RowBox[{"MBConicHulls`Private`STNSReturn", "=", 
                    RowBox[{"FullSimplify", "[", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    
                    RowBox[{"MBConicHulls`Private`CanonicalMB", "[", 
                    "MBConicHulls`Private`i", "]"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{"MBConicHulls`Private`i", ",", 
                    "MBConicHulls`Private`STNSReturn"}], "}"}]}], "]"}], 
                    "]"}]}], ";", 
                    RowBox[{"MBConicHulls`Private`STNSReturn", "=", 
                    RowBox[{"Table", "[", 
                    RowBox[{
                    
                    RowBox[{"MBConicHulls`Private`ReArrangeMB", "[", 
                    "MBConicHulls`Private`i", "]"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{"MBConicHulls`Private`i", ",", 
                    "MBConicHulls`Private`STNSReturn"}], "}"}]}], "]"}]}], 
                    ";"}]}], "]"}], ";"}], "]"}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    
                    RowBox[{"Length", "[", "MBConicHulls`Private`DumVar", 
                    "]"}], ">", "0"}], ",", 
                    RowBox[{
                    
                    RowBox[{"Print", "[", 
                    "\"Transforming PolyGamma function whose poles are split \
by the straight contour into Gamma function\"", "]"}], ";;", 
                    RowBox[{"Print", "[", 
                    
                    RowBox[{"\"Introduced Dummy variable : \"", ",", 
                    "MBConicHulls`Private`DumVarOnly"}], "]"}]}]}], "]"}], 
                    ";", 
                    RowBox[{"Print", "[", 
                    RowBox[{"\"Time Taken \"", ",", 
                    
                    RowBox[{"MBConicHulls`Private`TimeTaken", 
                    "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
                    ",", "\" seconds\""}], "]"}], ";", 
                    RowBox[{"AppendTo", "[", 
                    
                    RowBox[{"MBConicHulls`Private`STNSReturn", ",", 
                    "MBConicHulls`Private`DumVar"}], "]"}], ";", 
                    RowBox[{"Return", "[", 
                    RowBox[{"Join", "[", 
                    RowBox[{"MBConicHulls`Private`STNSReturn", ",", 
                    RowBox[{"{", "}"}]}], "]"}], "]"}], ";"}]}], "]"}]}]}, {
                   " "}, {
                    RowBox[{
                    RowBox[{"MBRep", "[", "MBConicHulls`Private`X___", "]"}], 
                    ":=", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Length", "[", 
                    RowBox[{"{", "MBConicHulls`Private`X", "}"}], "]"}], 
                    "\[NotEqual]", "4"}], ",", 
                    RowBox[{
                    RowBox[{"Print", "[", 
                    RowBox[{"\"Four arguments expected, but \"", ",", 
                    RowBox[{"Length", "[", 
