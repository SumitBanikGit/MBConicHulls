                    RowBox[{"-", "1"}], "}"}], "\[RightDoubleBracket]"}], ",", 
                    RowBox[{"{", "MBConicHulls`Private`ParQ", "}"}]}], 
                    "]"}]}]}], ";", 
                    RowBox[{"MBConicHulls`Private`SeriesNumber", "=", 
                    
                    RowBox[{"MBConicHulls`Private`CalculateResidueReturn", 
                    "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
                    ";", 
                    RowBox[{"MBConicHulls`Private`AllSeries", "=", 
                    
                    RowBox[{"MBConicHulls`Private`CalculateResidueReturn", 
                    "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], 
