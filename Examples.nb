        RowBox[{"AppellRandomPoint", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}]}], ",", 
      RowBox[{
       SubscriptBox["u", "2"], "\[Rule]", 
       RowBox[{"-", 
        RowBox[{"AppellRandomPoint", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}]}]}], "}"}]}]}], "]"}], "\[IndentingNewLine]", 
