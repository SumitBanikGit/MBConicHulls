  RowBox[{"SumAllSeries", "[", 
   RowBox[{
   "AppellEvaluateSeriesOut", ",", "AppellMBVarSub", ",", "AppellSumLim", ",", 
    RowBox[{"RunInParallel", "\[Rule]", "True"}]}], "]"}], ";"}], "\[IndentingNewLine]", 
