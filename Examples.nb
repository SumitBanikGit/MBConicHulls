                   1 -> MBConicHulls`Private`MBNumArg, 2 -> 
                    MBConicHulls`Private`MBDenArg}]; 
                MBConicHulls`Private`MBArgNew = 
                 MBConicHulls`Private`RemoveCommonGamma[
                  MBConicHulls`Private`MBArgNew]; Null]; 
              MBConicHulls`Private`DumVarOnly = Flatten[
                 Map[Most[#]& , MBConicHulls`Private`DumVar]]; 
              MBConicHulls`Private`TakeLimitAll = Join[
                 OptionValue[MBConicHulls`TakeLimit], 
                 Table[
                 MBConicHulls`Private`i -> 0, {
                  MBConicHulls`Private`i, MBConicHulls`Private`DumVarOnly}]]; 
              MBConicHulls`Private`STNSReturn = 
