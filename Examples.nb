  RowBox[{"(*", " ", 
   RowBox[{"Check", " ", "with", " ", "Hexagon"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SumLimHX", "=", "1"}], ";"}], " ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Increase", " ", "this", " ", "for", " ", "better", " ", "accuracy"}], 
    " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"SumAllSeries", "[", 
     RowBox[{
     "EvaluateSeriesResHXOut", ",", "ParameterSubHX", ",", "SumLimHX", ",", 
      RowBox[{"RunInParallel", "\[Rule]", "True"}], ",", 
      RowBox[{"NumericalPrecision", "\[Rule]", " ", "NPrecision"}]}], "]"}], 
