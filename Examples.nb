Cell[CellGroupData[{

Cell["Feynman Parametrization", "Subsection",
 CellChangeTimes->{{3.8269591831029205`*^9, 
  3.826959196595992*^9}},ExpressionUUID->"603a8eaa-8422-47de-8fe5-\
2337cb0f2d49"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"FeynmanIntegrand", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["\[Pi]", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["a", "1"], "+", 
           SubscriptBox["a", "2"], "+", 
           SubscriptBox["a", "3"]}], ")"}]}]], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           SubscriptBox["a", "1"], "+", 
           SubscriptBox["a", "2"], "+", 
           SubscriptBox["a", "3"]}], ")"}]}], "]"}], " ", 
       SubsuperscriptBox["\[Alpha]", "2", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SubscriptBox["a", "2"]}]], " ", 
       SubsuperscriptBox["\[Alpha]", "3", 
        RowBox[{
         RowBox[{"-", "1"}], "+", 
         SubscriptBox["a", "3"]}]], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", 
          SubscriptBox["\[Alpha]", "2"], "+", 
          SubscriptBox["\[Alpha]", "3"]}], ")"}], 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            SubscriptBox["a", "1"]}], "-", 
           SubscriptBox["a", "2"], "-", 
           SubscriptBox["a", "3"]}], ")"}]}]], " ", 
       SuperscriptBox[
        RowBox[{"(", 
         FractionBox[
          RowBox[{
           SubsuperscriptBox["m", "1", "2"], "+", 
           RowBox[{
            SubsuperscriptBox["m", "2", "2"], " ", 
            SubsuperscriptBox["\[Alpha]", "2", "2"]}], "+", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{"1", "-", 
              RowBox[{"2", " ", "w"}]}], ")"}], " ", 
            SubscriptBox["m", "2"], " ", 
            SubscriptBox["m", "3"], " ", 
            SubscriptBox["\[Alpha]", "2"], " ", 
            SubscriptBox["\[Alpha]", "3"]}], "+", 
           RowBox[{
            SubsuperscriptBox["m", "3", "2"], " ", 
            SubsuperscriptBox["\[Alpha]", "3", "2"]}], "+", 
           RowBox[{"2", " ", 
            SubscriptBox["m", "1"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"2", " ", "u"}]}], ")"}], " ", 
               SubscriptBox["m", "2"], " ", 
               SubscriptBox["\[Alpha]", "2"]}], "+", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 RowBox[{"2", " ", "v"}]}], ")"}], " ", 
               SubscriptBox["m", "3"], " ", 
               SubscriptBox["\[Alpha]", "3"]}]}], ")"}]}]}], 
          RowBox[{"1", "+", 
           SubscriptBox["\[Alpha]", "2"], "+", 
           SubscriptBox["\[Alpha]", "3"]}]], ")"}], 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"-", 
            SubscriptBox["a", "1"]}], "-", 
           SubscriptBox["a", "2"], "-", 
           SubscriptBox["a", "3"]}], ")"}]}]]}], ")"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Gamma", "[", 
        SubscriptBox["a", "1"], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        SubscriptBox["a", "2"], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        SubscriptBox["a", "3"], "]"}]}], ")"}]}], "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       SubscriptBox["m", "1"], "\[Rule]", " ", "1"}], ",", 
      RowBox[{
       SubscriptBox["m", "2"], "\[Rule]", " ", "1"}], ",", 
      RowBox[{
       SubscriptBox["m", "3"], "\[Rule]", "1"}]}], "}"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"FP", "[", 
    RowBox[{
    "a1_", ",", "a2_", ",", "a3_", ",", "u1_", ",", "v1_", ",", "w1_"}], 
    "]"}], ":=", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{"FeynmanIntegrand", "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         SubscriptBox["a", "1"], "\[Rule]", " ", "a1"}], ",", 
        RowBox[{
         SubscriptBox["a", "2"], "\[Rule]", " ", "a2"}], ",", 
        RowBox[{
         SubscriptBox["a", "3"], "\[Rule]", " ", "a3"}], ",", 
        RowBox[{"u", "\[Rule]", " ", "u1"}], ",", 
        RowBox[{"v", "\[Rule]", " ", "v1"}], ",", 
        RowBox[{"w", "\[Rule]", " ", "w1"}]}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Alpha]", "2"], ",", "0", ",", "Infinity"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["\[Alpha]", "3"], ",", "0", ",", "Infinity"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.8269591989991837`*^9, 3.8269592134553328`*^9}, {
  3.8269592485741234`*^9, 3.826959262557235*^9}, {3.826959317038561*^9, 
  3.826959320190231*^9}, {3.8269602925926275`*^9, 3.826960293848621*^9}, {
