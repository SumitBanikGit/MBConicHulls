              MBConicHulls`Private`IntVarNew = 
               Map[First[#]& , MBConicHulls`Private`IntVar]; 
              MBConicHulls`Private`Contour = 
               Map[Last[#]& , MBConicHulls`Private`IntVar]; 
              MBConicHulls`Private`ContourString = Table[
