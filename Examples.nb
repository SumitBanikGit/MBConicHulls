  InformationData[<|
   "ObjectType" -> "Symbol", "Usage" -> 
    "ResolveMB[MBRepOut_,MBNumber->1,MaxSolutions->Infinity,PrintSolutions->\
True,MasterSeries->True]  returns the type of integral (degenerate or \
nondegenerate) and the total number of conic hulls, and then goes on to \
display the list of relevant intersecting conic hulls and the sets of poles \
for each series representation along with the master series characteristic \
list and variables for the degenerate case. The function arguments are: \n\
MBRepOut - is the output of the MBRep[] function. \nMBNumber:: is an optional \
parameter which specifies the number of the MB to be solved among the ones \
returned by MBRep[]. Its default value is 1. \nMaxSolutions - is an optional \
parameter which specifies the maximum number of series solutions of the MB \
integral that one wishes to evaluate. Its default value is Infinity. \n\
PrintSolutions - is an optional parameter which specifies whether to print \
the list of possible solutions along with their list of poles or not. Its \
default value is True.\nMasterSeries - is an optional parameter which \
specifies whether to compute the master series for each of the series \
solutions found or not. Its default value is True.\n", "Documentation" -> 
    None, "OwnValues" -> None, "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, MBConicHulls`ResolveMB, {MBConicHulls`ResolveMB[
         Pattern[MBConicHulls`Private`MBRepIn, 
          Blank[]], 
         OptionsPattern[]] :> 
       Module[{MBConicHulls`Private`msg1, 
          MBConicHulls`Private`FindIntersectionReturn, 
          MBConicHulls`Private`MBRepVars, MBConicHulls`Private`IntVar, 
          MBConicHulls`Private`MBRepVarsFlatten, MBConicHulls`Private`NumFlat,
           MBConicHulls`Private`DenFlat, MBConicHulls`Private`NumGamma, 
          MBConicHulls`Private`DenGamma, MBConicHulls`Private`NumCof, 
          MBConicHulls`Private`DenCof, MBConicHulls`Private`NumDenIntCof, 
          MBConicHulls`Private`Delta, MBConicHulls`Private`ProportionalQ, 
          MBConicHulls`Private`AnyProportionalQ, MBConicHulls`Private`RetTup, 
          MBConicHulls`Private`MaxRequestedSeries = 
          OptionValue[MBConicHulls`MaxSolutions], 
          MBConicHulls`Private`TimeTaken, MBConicHulls`Private`LengthMessage = 
          "", MBConicHulls`Private`LengthList, 
          MBConicHulls`Private`LengthTally, MBConicHulls`Private`Dim, 
          MBConicHulls`Private`Degenerate, MBConicHulls`Private`F, 
          MBConicHulls`Private`FSort, MBConicHulls`Private`Comb, 
          MBConicHulls`Private`Poles, MBConicHulls`Private`CombLabels, 
          MBConicHulls`Private`MasterCharList = {}, 
          MBConicHulls`Private`MasterSeriesVar = {}, 
          MBConicHulls`Private`Msg2 = {}, MBConicHulls`Private`RearrangePos, 
          MBConicHulls`Private`PrintSol = 
          OptionValue[MBConicHulls`PrintSolutions], 
          MBConicHulls`Private`MasterSeriesQ = 
          OptionValue[MBConicHulls`MasterSeries], 
          MBConicHulls`Private`MBRepInput = 
          Most[MBConicHulls`Private`MBRepIn], MBConicHulls`Private`DumVar = 
          Part[MBConicHulls`Private`MBRepIn, -1]}, 
         If[OptionValue[MBConicHulls`MBNumber] > 
           Length[MBConicHulls`Private`MBRepInput], 
           Print["The MB number to be evaluated is greater than the total \
number of series solution found."]; Abort[]]; 
         If[Length[MBConicHulls`Private`MBRepInput] > 1, 
           Print["Solving MB Number : ", 
            OptionValue[MBConicHulls`MBNumber]]]; 
         MBConicHulls`Private`MBRepVars = 
          Part[MBConicHulls`Private`MBRepInput, 
            OptionValue[MBConicHulls`MBNumber]]; 
         MBConicHulls`Private`Dim = MBConicHulls`Private`MBRepDim[
            Part[MBConicHulls`Private`MBRepInput, 
             OptionValue[MBConicHulls`MBNumber]]]; 
         MBConicHulls`Private`IntVar = Part[
            Part[MBConicHulls`Private`MBRepInput, 
             OptionValue[MBConicHulls`MBNumber]], 2]; 
         MBConicHulls`Private`NumGamma = (Select[#, Head[#] =!= List& ]& )[
            Part[MBConicHulls`Private`MBRepVars, 4, 1]]; 
         MBConicHulls`Private`DenGamma = (Select[#, Head[#] =!= List& ]& )[
            Part[MBConicHulls`Private`MBRepVars, 4, 2]]; 
         MBConicHulls`Private`NumFlat = (Select[#, Head[#] =!= Integer& ]& )[
            Flatten[
             Part[MBConicHulls`Private`MBRepVars, 4, 1]]]; 
         MBConicHulls`Private`DenFlat = (Select[#, Head[#] =!= Integer& ]& )[
            Flatten[
             Part[MBConicHulls`Private`MBRepVars, 4, 2]]]; 
         MBConicHulls`Private`MBRepVarsFlatten = 
          ReplacePart[
           MBConicHulls`Private`MBRepVars, {{4, 1} -> 
             MBConicHulls`Private`NumFlat, {4, 2} -> 
             MBConicHulls`Private`DenFlat}]; 
         MBConicHulls`Private`NumCof = 
          Map[Coefficient[#, MBConicHulls`Private`IntVar]& , 
            MBConicHulls`Private`NumGamma]; 
         MBConicHulls`Private`DenCof = 
          Map[Coefficient[#, MBConicHulls`Private`IntVar]& , 
            MBConicHulls`Private`DenGamma]; 
         MBConicHulls`Private`TimeTaken = AbsoluteTiming[If[
              Not[MBConicHulls`Private`PrintSol], 
              MBConicHulls`Private`MasterSeriesQ = False]; 
            MBConicHulls`Private`FindIntersectionReturn = 
             MBConicHulls`Private`FindIntersection[
              MBConicHulls`Private`MBRepVars, 
               MBConicHulls`Private`MaxRequestedSeries, 
               MBConicHulls`Private`MasterSeriesQ, 
               OptionValue[MBConicHulls`RunInParallel]]; {
              MBConicHulls`Private`F, MBConicHulls`Private`Comb, 
               MBConicHulls`Private`Poles, MBConicHulls`Private`msg1, 
               MBConicHulls`Private`Msg2, MBConicHulls`Private`MasterCharList,
                MBConicHulls`Private`MasterSeriesVar, 
               MBConicHulls`Private`Degenerate} = 
             Part[MBConicHulls`Private`FindIntersectionReturn, {1, 2, 3, 4, 5,
                9, 10, 11}]; MBConicHulls`Private`FSort = Sort[
               Sort[MBConicHulls`Private`F, Length[#] < Length[#2]& ]]; 
            MBConicHulls`Private`RearrangePos = Flatten[
               Map[
               Position[MBConicHulls`Private`F, #]& , 
                MBConicHulls`Private`FSort]]; If[
              And[
              MBConicHulls`Private`MasterSeriesQ, 
               MBConicHulls`Private`Degenerate], 
              MBConicHulls`Private`MasterCharList = 
               Part[MBConicHulls`Private`MasterCharList, 
                 MBConicHulls`Private`RearrangePos]; 
              MBConicHulls`Private`MasterSeriesVar = 
               Part[MBConicHulls`Private`MasterSeriesVar, 
                 MBConicHulls`Private`RearrangePos]; Null]; 
            Do[MBConicHulls`Private`CombLabels = 
               Part[MBConicHulls`Private`FSort, 
                 MBConicHulls`Private`SeriesRepCount]; Which[
                And[
                MBConicHulls`Private`Degenerate, MBConicHulls`Private`Dim >= 
                 2, MBConicHulls`Private`MasterSeriesQ], 
                MBConicHulls`Private`Msg2 = Append[MBConicHulls`Private`Msg2, 
                  StringForm[
                  "\!\(\*StyleBox[\"Series\",FontWeight->\"Bold\"]\)\!\(\*\
StyleBox[\" \
\",FontWeight->\"Bold\"]\)\!\(\*StyleBox[\"Solution\",FontWeight->\"Bold\"]\) \
`1` :: Cardinality `2`. Intersecting Conic Hulls `3`. Set of poles :: `4` \
with master series characteristic list and variables `5`.", 
                   MBConicHulls`Private`SeriesRepCount, 
                   Length[MBConicHulls`Private`CombLabels], 
                   Map[Subscript[C, 
                    Apply[Sequence, 
                    Part[MBConicHulls`Private`Comb, #]]]& , 
                    MBConicHulls`Private`CombLabels], 
                   Map[Expand[
                    Part[MBConicHulls`Private`Poles, #]]& , 
                    MBConicHulls`Private`CombLabels], 
                   Join[{
                    Part[
                    MBConicHulls`Private`MasterCharList, 
                    MBConicHulls`Private`SeriesRepCount]}, {
                    Part[
                    MBConicHulls`Private`MasterSeriesVar, 
                    MBConicHulls`Private`SeriesRepCount]}]]], 
                And[
                MBConicHulls`Private`Degenerate, MBConicHulls`Private`Dim === 
                 1, MBConicHulls`Private`MasterSeriesQ], 
                MBConicHulls`Private`Msg2 = Append[MBConicHulls`Private`Msg2, 
                  StringForm[
                  "\!\(\*StyleBox[\"Series\",FontWeight->\"Bold\"]\)\!\(\*\
StyleBox[\" \
\",FontWeight->\"Bold\"]\)\!\(\*StyleBox[\"Solution\",FontWeight->\"Bold\"]\) \
`1` :: Cardinality `2`. Intersecting Conic Hulls `3`. Set of poles :: `4` \
with master series characteristic list and variables `5`.", 
                   MBConicHulls`Private`SeriesRepCount, 
                   Length[MBConicHulls`Private`CombLabels], 
                   Map[Subscript[C, 
                    Apply[Sequence, 
                    Part[MBConicHulls`Private`Comb, #]]]& , 
                    MBConicHulls`Private`CombLabels], 
                   Map[Expand[
                    Part[MBConicHulls`Private`Poles, #]]& , 
                    MBConicHulls`Private`CombLabels], 
                   Join[{
                    Part[
                    MBConicHulls`Private`MasterCharList, 
                    MBConicHulls`Private`SeriesRepCount]}, {
                    Part[
                    MBConicHulls`Private`MasterSeriesVar, 
                    MBConicHulls`Private`SeriesRepCount]}]]], True, 
                MBConicHulls`Private`Msg2 = Append[MBConicHulls`Private`Msg2, 
                   StringForm[
                   "\!\(\*StyleBox[\"Series\",FontWeight->\"Bold\"]\)\!\(\*\
StyleBox[\" \
\",FontWeight->\"Bold\"]\)\!\(\*StyleBox[\"Solution\",FontWeight->\"Bold\"]\) \
`1` :: Cardinality `2`. Intersecting Conic Hulls `3`. Set of poles :: `4`.", 
                    MBConicHulls`Private`SeriesRepCount, 
                    Length[MBConicHulls`Private`CombLabels], 
                    Map[Subscript[C, 
                    Apply[Sequence, 
                    Part[MBConicHulls`Private`Comb, #]]]& , 
                    MBConicHulls`Private`CombLabels], 
                    Map[Expand[
                    Part[MBConicHulls`Private`Poles, #]]& , 
                    MBConicHulls`Private`CombLabels]]]; Null]; Null, {
              MBConicHulls`Private`SeriesRepCount, 
               Length[MBConicHulls`Private`FSort]}]; 
            MBConicHulls`Private`LengthList = Map[Length[#]& , 
               Part[MBConicHulls`Private`FindIntersectionReturn, 1]]; 
            MBConicHulls`Private`LengthTally = 
             Tally[MBConicHulls`Private`LengthList]; 
            MBConicHulls`Private`LengthTally = 
             Sort[MBConicHulls`Private`LengthTally, Part[#, 1] < 
               Part[#2, 1]& ]; 
            Do[MBConicHulls`Private`LengthMessage = 
              MBConicHulls`Private`LengthMessage <> "Cardinality " <> ToString[
                 Part[
                  Part[
                  MBConicHulls`Private`LengthTally, MBConicHulls`Private`i], 
                  1]] <> ":: Solution found " <> ToString[
                 Part[
                  Part[
                  MBConicHulls`Private`LengthTally, MBConicHulls`Private`i], 
                  2]] <> ".\n", {MBConicHulls`Private`i, 
               Length[MBConicHulls`Private`LengthTally]}]; Print["Found ", 
              Length[MBConicHulls`Private`Msg2], " series solutions."]; 
            Print[MBConicHulls`Private`LengthMessage]; 
            If[MBConicHulls`Private`PrintSol, 
              Do[Print[
                 Part[MBConicHulls`Private`Msg2, MBConicHulls`Private`i]]; 
               Print[""], {MBConicHulls`Private`i, 
                Length[MBConicHulls`Private`Msg2]}]]]; Print["Time Taken ", 
           Part[MBConicHulls`Private`TimeTaken, 1], " seconds"]; 
         MBConicHulls`Private`FindIntersectionReturn = 
          ReplacePart[
           MBConicHulls`Private`FindIntersectionReturn, {
            1 -> MBConicHulls`Private`FSort, 8 -> 
             Part[MBConicHulls`Private`MBRepInput, 
               OptionValue[MBConicHulls`MBNumber]]}]; 
         AppendTo[
          MBConicHulls`Private`FindIntersectionReturn, 
           MBConicHulls`Private`DumVar]; 
         Return[MBConicHulls`Private`FindIntersectionReturn]]}], "SubValues" -> 
    None, "DefaultValues" -> None, "NValues" -> None, "FormatValues" -> None, 
    "Options" -> {
     MBConicHulls`MaxSolutions -> DirectedInfinity[1], 
