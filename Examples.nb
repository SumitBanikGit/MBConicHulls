                    "\[RightDoubleBracket]"}]}], "}"}]}], "]"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{"MBConicHulls`Private`k", ",", 
                    "MBConicHulls`Private`SeriesNumber"}], "}"}]}], "]"}]}], 
                    ";", 
                    RowBox[{"MBConicHulls`Private`PowerVals", "=", 
                    RowBox[{"Function", "[", 
