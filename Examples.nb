                    RowBox[{"FreeQ", "[", 
                    RowBox[{"MBConicHulls`Private`b", ",", 
                    SubscriptBox["n", "_"]}], "]"}], "&&", 
                    RowBox[{"!", 
                    RowBox[{"FreeQ", "[", 
