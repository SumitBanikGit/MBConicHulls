               " MB integrals after transforming from straight to \
non-straight contour"]]; If[
              OptionValue[MBConicHulls`CanonicalTransform], 
              PrintTemporary["Transforming into canonical form"]; 
              MBConicHulls`Private`STNSReturn = FullSimplify[
                 Table[
