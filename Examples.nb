Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"PrefacSet1", "=", 
    RowBox[{
     FractionBox[
      RowBox[{
       SuperscriptBox["2", 
        RowBox[{"1", "-", 
         SubscriptBox["a", "1"], "-", 
         SubscriptBox["a", "2"], "-", 
         SubscriptBox["a", "3"]}]], " ", 
       SuperscriptBox["\[Pi]", 
        RowBox[{
         FractionBox["1", "2"], " ", 
         RowBox[{"(", 
          RowBox[{"1", "+", 
           SubscriptBox["a", "1"], "+", 
           SubscriptBox["a", "2"], "+", 
           SubscriptBox["a", "3"]}], ")"}]}]], " ", 
       SubsuperscriptBox["m", "1", 
        RowBox[{"-", 
         SubscriptBox["a", "1"]}]], " ", 
       SubsuperscriptBox["m", "2", 
        RowBox[{"-", 
         SubscriptBox["a", "2"]}]], " ", 
       SubsuperscriptBox["m", "3", 
        RowBox[{"-", 
         SubscriptBox["a", "3"]}]]}], 
      RowBox[{
       RowBox[{"Gamma", "[", 
        SubscriptBox["a", "1"], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        SubscriptBox["a", "2"], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        SubscriptBox["a", "3"], "]"}]}]], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["m", "1"], "\[Rule]", " ", "1"}], ",", 
       RowBox[{
        SubscriptBox["m", "2"], "\[Rule]", " ", "1"}], ",", 
       RowBox[{
        SubscriptBox["m", "3"], "\[Rule]", "1"}]}], "}"}]}]}], ";"}], " "}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MBSet1", "=", 
   RowBox[{"MBRep", "[", 
