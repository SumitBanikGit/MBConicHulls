                    RowBox[{"Times", "@@", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    SuperscriptBox[
                    
                    RowBox[{"#1", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], 
                    RowBox[{"Coefficient", "[", 
                    RowBox[{
                    
                    RowBox[{"#1", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}], ",", 
                    SubscriptBox["n", "MBConicHulls`Private`j"]}], "]"}]], 
                    "&"}], ")"}], "/@", "MBConicHulls`Private`Pows"}]}], 
                    "]"}], "]"}], "]"}]}], ";", 
