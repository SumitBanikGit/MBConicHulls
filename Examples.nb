Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"MaxErrorIncreaseHX", "=", "5000"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "Increase", " ", "this", " ", "for", " ", "better", " ", "accuracy"}], " ",
    "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"WorkingPrecisionHX", "=", "MachinePrecision"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HXFP", "[", 
   RowBox[{
   "PropagatorSubNonResHX", ",", "ParameterSubHX", ",", "MaxErrorIncreaseHX", 
    ",", "WorkingPrecisionHX"}], "]"}], " ", 
  RowBox[{"(*", " ", 
