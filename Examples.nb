                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{"MBConicHulls`Private`i", ",", 
                    RowBox[{"And", "@@", 
                    RowBox[{
                    RowBox[{"(", 
                    RowBox[{
                    RowBox[{
                    SubscriptBox["n", "#1"], "\[GreaterEqual]", "0"}], "&"}], 
                    ")"}], "/@", 
                    
                    RowBox[{"Range", "[", "MBConicHulls`Private`Dim", 
                    "]"}]}]}], ",", "Nothing", ",", 
                    "MBConicHulls`Private`i"}], "]"}], ",", 
                    RowBox[{"{", 
                    
                    RowBox[{"MBConicHulls`Private`i", ",", 
                    "MBConicHulls`Private`SeriesCondition"}], "}"}]}], 
