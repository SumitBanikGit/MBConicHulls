Cell[TextData[{
 "Numerical evaluation of the Hexagon series representation for values of the \
parameters in ParameterSubHX, with summation upper-limit SumLimHX. The chosen \
values of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["u", "i"], TraditionalForm]],ExpressionUUID->
  "89511ba5-f3dc-447e-96cb-83665bdbbded"],
 "have been deduced from the master series analysis."
}], "Text",
