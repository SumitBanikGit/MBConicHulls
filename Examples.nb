Cell[BoxData[
 RowBox[{
  RowBox[{"AppellMBRepOut", "=", 
   RowBox[{"MBRep", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"Gamma", "[", "c", "]"}], 
      RowBox[{
       RowBox[{"Gamma", "[", "a", "]"}], 
       RowBox[{"Gamma", "[", 
        SubscriptBox["b", "1"], "]"}], 
       RowBox[{"Gamma", "[", 
        SubscriptBox["b", "2"], "]"}]}]], ",", 
     RowBox[{"{", 
      RowBox[{
       SubscriptBox["z", "1"], ",", 
       SubscriptBox["z", "2"]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        SubscriptBox["u", "1"]}], ",", 
       RowBox[{"-", 
        SubscriptBox["u", "2"]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", 
          SubscriptBox["z", "1"]}], ",", 
         RowBox[{"-", 
          SubscriptBox["z", "2"]}], ",", 
         RowBox[{"a", "+", 
          SubscriptBox["z", "1"], "+", 
          SubscriptBox["z", "2"]}], ",", 
         RowBox[{
          SubscriptBox["b", "1"], "+", 
          SubscriptBox["z", "1"]}], ",", 
         RowBox[{
          SubscriptBox["b", "2"], "+", 
          SubscriptBox["z", "2"]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"c", "+", 
         SubscriptBox["z", "1"], "+", 
         SubscriptBox["z", "2"]}], "}"}]}], "}"}]}], "]"}]}], " ", 
