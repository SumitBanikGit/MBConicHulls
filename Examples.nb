Cell[CellGroupData[{

Cell["\<\
Nonresonant Case using Conic Hull Approach (generic propagator powers)\
\>", "Subsection",
 CellChangeTimes->{{3.8289558674930773`*^9, 3.8289559045651426`*^9}, {
  3.8290129935473256`*^9, 3.8290130002676387`*^9}, {3.832990875724454*^9, 
