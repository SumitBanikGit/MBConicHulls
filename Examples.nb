                    RowBox[{"MBConicHulls`Private`k", ",", 
                    "MBConicHulls`Private`SeriesNumber"}], "}"}]}], "]"}]}], 
                    "]"}]}], ";", 
                    RowBox[{"MBConicHulls`Private`SumLimList", "=", 
