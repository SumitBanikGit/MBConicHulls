Cell[BoxData[{
 RowBox[{
  RowBox[{"ParameterSubHX", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"u1", "->", "1"}], ",", 
     RowBox[{"u2", "->", 
      RowBox[{"1", "/", "100"}]}], ",", 
     RowBox[{"u3", "->", 
      SuperscriptBox["10", "10"]}], ",", 
