 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"1ae780aa-6790-4fe5-8cde-5bf2dfb1515d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Q33", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[Pi]", "DD"], 
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"DD", "/", "2"}], "-", "l"}], "]"}], 
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"DD", "/", "2"}], "-", "f"}], "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Gamma", "[", "a", "]"}], 
      RowBox[{"Gamma", "[", "b", "]"}], 
      RowBox[{"Gamma", "[", "c", "]"}], 
      RowBox[{"Gamma", "[", "l", "]"}], 
      RowBox[{"Gamma", "[", "d", "]"}], 
      RowBox[{"Gamma", "[", "e", "]"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PrefacDB", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"Q33", "*", 
      SuperscriptBox[
       RowBox[{"(", "u8", ")"}], 
       RowBox[{
        RowBox[{"DD", "/", "2"}], "-", "l"}]]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"DD", "/", "2"}], "-", "f"}], "]"}], 
      RowBox[{"Gamma", "[", "f", "]"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
