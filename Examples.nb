                    RowBox[{"{", 
                    
                    RowBox[{"MBConicHulls`Private`BaseIn", ",", 
                    "MBConicHulls`Private`ExpVals", ",", 
                    "MBConicHulls`Private`Prec"}], "}"}], ",", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"MBConicHulls`Private`BaseN", "=", 
                    RowBox[{"N", "[", 
                    
                    RowBox[{"MBConicHulls`Private`BaseIn", ",", 
                    "MBConicHulls`Private`Prec"}], "]"}]}], ",", 
                    RowBox[{"MBConicHulls`Private`ExpN", "=", 
                    RowBox[{"N", "[", 
                    
                    RowBox[{"MBConicHulls`Private`ExpVals", ",", 
                    "MBConicHulls`Private`Prec"}], "]"}]}], ",", 
                    "MBConicHulls`Private`ExpRound", ",", 
                    "MBConicHulls`Private`Tol"}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"MBConicHulls`Private`Tol", "=", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    
                    RowBox[{"MBConicHulls`Private`Prec", "===", 
                    "MachinePrecision"}], ",", 
                    FractionBox["1", 
                    SuperscriptBox["10", "10"]], ",", 
                    SuperscriptBox["10", 
                    RowBox[{"-", 
                    RowBox[{"Min", "[", 
                    RowBox[{"20", ",", 
                    RowBox[{"Max", "[", 
                    RowBox[{"10", ",", 
                    RowBox[{"Floor", "[", 
                    FractionBox["MBConicHulls`Private`Prec", "2"], "]"}]}], 
                    "]"}]}], "]"}]}]]}], "]"}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"TrueQ", "[", 
                    RowBox[{
                    RowBox[{"Chop", "[", 
                    RowBox[{"Im", "[", "MBConicHulls`Private`BaseN", "]"}], 
                    "]"}], "\[Equal]", "0"}], "]"}], "&&", 
                    RowBox[{"TrueQ", "[", 
                    RowBox[{
                    RowBox[{"Re", "[", "MBConicHulls`Private`BaseN", "]"}], 
                    "<", "0"}], "]"}]}], ",", 
                    RowBox[{
                    RowBox[{"MBConicHulls`Private`ExpRound", "=", 
                    
                    RowBox[{"Round", "[", "MBConicHulls`Private`ExpN", 
                    "]"}]}], ";", 
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"Max", "[", 
                    RowBox[{"Abs", "[", 
                    RowBox[{"Flatten", "[", 
                    RowBox[{"{", 
                    
                    RowBox[{"MBConicHulls`Private`ExpN", "-", 
                    "MBConicHulls`Private`ExpRound"}], "}"}], "]"}], "]"}], 
                    "]"}], "<", "MBConicHulls`Private`Tol"}], ",", 
                    RowBox[{
                    SuperscriptBox[
                    RowBox[{"(", 
                    RowBox[{"-", "1"}], ")"}], 
                    "MBConicHulls`Private`ExpRound"], " ", 
                    SuperscriptBox[
                    RowBox[{"Abs", "[", "MBConicHulls`Private`BaseN", "]"}], 
                    "MBConicHulls`Private`ExpRound"]}], ",", 
                    SuperscriptBox[
                    "MBConicHulls`Private`BaseN", 
                    "MBConicHulls`Private`ExpN"]}], "]"}]}], ",", 
                    SuperscriptBox[
                    "MBConicHulls`Private`BaseN", 
                    "MBConicHulls`Private`ExpN"]}], "]"}]}]}], "]"}]}], 
                    "]"}]}], ";", 
                    RowBox[{"MBConicHulls`Private`OkQ", "=", 
                    RowBox[{"Function", "[", 
                    RowBox[{"MBConicHulls`Private`x", ",", 
