                    Part[
                    MBConicHulls`Private`MBNumArg, MBConicHulls`Private`i, 2], 
                    OptionValue[MBConicHulls`TakeLimit]], 
                    MBConicHulls`Private`ContourSub] < 0, 
                    Which[Part[
                    MBConicHulls`Private`MBNumArg, MBConicHulls`Private`i, 1] === 
                    0, AppendTo[MBConicHulls`Private`MBDenArg, 
                    Part[
                    MBConicHulls`Private`MBNumArg, MBConicHulls`Private`i, 
                    2]]; AppendTo[MBConicHulls`Private`DumVar, {
                    Subscript[MBConicHulls`\[Iota], MBConicHulls`Private`i], 
                    0}]; MBConicHulls`Private`MBNumArg = 
                    ReplacePart[
                    MBConicHulls`Private`MBNumArg, {
                    MBConicHulls`Private`i -> 
                    Subscript[MBConicHulls`\[Iota], MBConicHulls`Private`i] + 
                    Part[MBConicHulls`Private`MBNumArg, 
                    MBConicHulls`Private`i, 2]}], 
                    Part[MBConicHulls`Private`MBNumArg, 
                    MBConicHulls`Private`i, 1] > 0, 
                    AppendTo[
