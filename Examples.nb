Cell[CellGroupData[{

Cell["Hexagon MB", "Subsubsection",
 CellChangeTimes->{{3.828961791467963*^9, 3.828961800038726*^9}, {
  3.8987707801226377`*^9, 
  3.8987707807469254`*^9}},ExpressionUUID->"7d248de5-3395-4a66-b8b9-\
792a3f6f5a47"],

Cell["\<\
Mellin - Barnes representation of the Hexagon subject to the conformal \
constraint a + b + c + d + e + f = DD, where DD is the space-time dimension \
and a,b, c, d, e, f are propagator powers.\
\>", "Text",
 CellChangeTimes->{{3.832775795818606*^9, 3.8327759109416704`*^9}, {
  3.832989533855892*^9, 3.8329895500323143`*^9}},
 FontSize->10,
 Background->RGBColor[
  0.87, 0.94, 1],ExpressionUUID->"2288ea25-da70-4928-8d00-3de1ab1e9b78"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"SubHX", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Alpha]", "->", 
      RowBox[{
       RowBox[{"DD", "/", "2"}], "-", "f"}]}], ",", 
     RowBox[{"\[Beta]1", "->", "b"}], ",", 
     RowBox[{"\[Beta]2", "->", "c"}], ",", 
     RowBox[{"\[Beta]3", "->", "d"}], ",", 
     RowBox[{"\[Gamma]1", "->", 
      RowBox[{"1", "+", 
       RowBox[{"DD", "/", "2"}], "-", "a", "-", "f"}]}], ",", 
     RowBox[{"\[Gamma]2", "->", 
      RowBox[{"1", "+", 
       RowBox[{"DD", "/", "2"}], "-", "e", "-", "f"}]}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"PrefacHX", "=", 
   RowBox[{
    SuperscriptBox["\[Pi]", 
     RowBox[{
     "2", "+", "\[Alpha]", "+", "\[Beta]1", "+", "\[Beta]2", "+", "\[Beta]3", 
      "-", "\[Gamma]1", "-", "\[Gamma]2"}]], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Gamma", "[", "\[Beta]1", "]"}], 
      RowBox[{"Gamma", "[", "\[Beta]2", "]"}], 
      RowBox[{"Gamma", "[", "\[Beta]3", "]"}], 
      RowBox[{"Gamma", "[", 
       RowBox[{"1", "+", "\[Alpha]", "-", "\[Gamma]1"}], "]"}], 
      RowBox[{"Gamma", "[", 
       RowBox[{"1", "+", "\[Alpha]", "-", "\[Gamma]2"}], "]"}], 
      RowBox[{"Gamma", "[", 
       RowBox[{
       "2", "+", "\[Beta]1", "+", "\[Beta]2", "+", "\[Beta]3", "-", 
        "\[Gamma]1", "-", "\[Gamma]2"}], "]"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"MBVarHXConvert", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["w", "1"], "\[Rule]", " ", "u3"}], ",", 
     RowBox[{
      SubscriptBox["w", "2"], "\[Rule]", " ", 
      RowBox[{"u3", " ", "u5"}]}], ",", " ", 
     RowBox[{
      SubscriptBox["w", "3"], "\[Rule]", " ", 
      RowBox[{"u3", " ", "u5", " ", "u7"}]}], ",", " ", 
     RowBox[{
      SubscriptBox["w", "4"], "\[Rule]", "  ", "u9"}], ",", " ", 
     RowBox[{
      SubscriptBox["w", "5"], "\[Rule]", "  ", 
      RowBox[{"u2", " ", "u3", " ", "u9"}]}], ",", " ", 
     RowBox[{
      SubscriptBox["w", "6"], "\[Rule]", "  ", 
      RowBox[{"u2", " ", "u3", " ", "u4", " ", "u5", " ", "u9"}]}], ",", " ", 
     RowBox[{
      SubscriptBox["w", "7"], "\[Rule]", "  ", 
      RowBox[{"u8", " ", "u9"}]}], ",", " ", 
     RowBox[{
      SubscriptBox["w", "8"], "\[Rule]", "  ", 
      RowBox[{"u1", " ", "u2", " ", "u3", " ", "u8", " ", "u9"}]}], ",", " ", 
     RowBox[{
      SubscriptBox["w", "9"], "\[Rule]", "  ", 
      RowBox[{"u6", " ", "u8", " ", "u9"}]}]}], "}"}]}], ";"}]}], "Input",
