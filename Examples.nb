Cell[BoxData[{
 RowBox[{
  RowBox[{"Q6", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[Pi]", 
       RowBox[{"DD", "/", "2"}]], 
      RowBox[{"Gamma", "[", 
       RowBox[{
        RowBox[{"DD", "/", "2"}], "-", "f"}], "]"}]}], ")"}], "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Gamma", "[", "a", "]"}], 
      RowBox[{"Gamma", "[", "b", "]"}], 
      RowBox[{"Gamma", "[", "c", "]"}], 
      RowBox[{"Gamma", "[", "d", "]"}], 
      RowBox[{"Gamma", "[", "e", "]"}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"X2", "=", 
   RowBox[{
    RowBox[{"b2", " ", "u6", " ", "u9"}], " ", "+", 
    RowBox[{"b3", " ", "u9"}], " ", "+", " ", 
    RowBox[{"b2", " ", "b3", " ", "u1", " ", "u2", " ", "u3", " ", "u9"}]}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Y", "=", 
   RowBox[{
    RowBox[{"X2", " ", "u8"}], " ", "+", 
    RowBox[{"b4", " ", "u9"}], "+", 
    RowBox[{"b2", " ", "b4", " ", "u2", " ", "u3", " ", "u9"}], "+", 
    RowBox[{
    "b3", " ", "b4", " ", "u2", " ", "u3", " ", "u4", " ", "u5", " ", "u9"}], 
    "+", "b5", "+", 
    RowBox[{"b2", " ", "b5", " ", "u3"}], "+", 
    RowBox[{"b3", " ", "b5", " ", "u3", " ", "u5"}], "+", 
    RowBox[{"b4", " ", "b5", " ", "u3", " ", "u5", " ", "u7"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Z4", "=", 
   RowBox[{"1", "+", "b2", "+", "b3", "+", "b4", "+", "b5"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ConformalConstraintHX", "=", 
   RowBox[{"{", 
    RowBox[{"DD", "\[Rule]", " ", 
     RowBox[{"a", "+", "b", "+", "c", "+", "d", "+", "e", "+", "f"}]}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DiffEqConstraintHX", "=", 
   RowBox[{"{", 
    RowBox[{"a", "->", 
     RowBox[{"d", "+", "e", "+", "f", "-", "b", "-", "c"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"HXIntegrand", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"Q6", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["b2", 
           RowBox[{"b", "-", "1"}]], 
          SuperscriptBox["b3", 
           RowBox[{"c", "-", "1"}]], 
          SuperscriptBox["b4", 
           RowBox[{"d", "-", "1"}]], 
          SuperscriptBox["b5", 
           RowBox[{"e", "-", "1"}]]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["Y", 
           RowBox[{
            RowBox[{"DD", "/", "2"}], "-", "f"}]], 
          SuperscriptBox["Z4", "f"]}], ")"}]}]}], "/.", 
      "ConformalConstraintHX"}], " ", "/.", "DiffEqConstraintHX"}], "//", 
    "Simplify"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.8264995844248896`*^9, 3.826499585641402*^9}, 
   3.8264997549662137`*^9, {3.826500301943823*^9, 3.826500439564457*^9}, {
