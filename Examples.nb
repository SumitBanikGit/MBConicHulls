Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"?", "EvaluateSeries"}]], "Input",
 CellChangeTimes->{{3.8286006745565834`*^9, 3.8286006891794825`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"e6fa53a3-b803-4b99-9983-c5d20369029c"],

Cell[BoxData[
 InterpretationBox[
  StyleBox[
   FrameBox[
    DynamicModuleBox[{System`InformationDump`open$$ = False, 
     System`InformationDump`mouseOver$$ = False}, 
     PaneSelectorBox[{True->
      TagBox[GridBox[{
         {
          ItemBox[
           PaneBox[
            StyleBox[
             TagBox[
              TooltipBox[
               StyleBox["\<\" Symbol\"\>", "InformationRowLabel",
                StripOnInput->False],
               "\"Symbol\"",
               TooltipStyle->"TextStyling"],
              Annotation[#, "Symbol", "Tooltip"]& ], "InformationTitleText",
             StripOnInput->False,
             BaseStyle -> None],
            FrameMargins->{{4, 0}, {-1, 1}}],
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationTitleBackground",
           StripOnInput->False]},
         {
          ItemBox[
           PaneBox[
            
            StyleBox["\<\"EvaluateSeries[ResolveMBOut_, MBParaSub_, \
SeriesNum_,PrintSeries->True,RearrangeSeries->False,RunInParallel->True] \
calculates and prints the series expression of the series representation \
SeriesNum. The function arguments are: \\nResolveMBOut - is the output of the \
ResolveMB[] or TriangulateMB[] function. \\nMBParaSub - is a list of \
substitutions to be made to the parameters in the arguments of the gamma \
functions of the integrand. \\nSeriesNum - is the number, as enumerated in \
the output of ResolveMB[] or TriangulateMB[], of the series for which we wish \
to calculate residues. \\nPrintSeries - is an optional parameter, which \
specifies whether to print the derived analytic solution or not. Its default \
value is True. \\nRearrangeSeries - is an optional parameter, which specifies \
whether to rearrange the summation indices such that each index runs from 0 \
to Infinity. Its default value is False. \\nRunInParallel - is an optional \
parameter, which specifies whether the residue computation is performed using \
Mathematica's parallel processing functionality. Its default value is \
True.\\n\"\>", "InformationUsageText",
             StripOnInput->False,
             LineSpacing->{1.5, 1.5, 3.}],
            FrameMargins->{{10, 10}, {8, 10}}],
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False], 
          ItemBox["\<\"\"\>",
           BaseStyle->"InformationUsageSubtitleBackground",
           StripOnInput->False]},
         {
          PaneBox[
           TagBox[GridBox[{
              {
               StyleBox[
                TagBox[
                 TooltipBox[
                  StyleBox["\<\" Definitions\"\>", "InformationRowLabel",
                   StripOnInput->False],
                  "\"Definitions\"",
                  TooltipStyle->"TextStyling"],
                 Annotation[#, "Definitions", "Tooltip"]& ], "DialogStyle",
                StripOnInput->False]},
              {
               TemplateBox[{"\"\[ThinSpace]\"", 
                 GridBox[{{
                    RowBox[{
                    RowBox[{"EvaluateSeries", "[", 
                    
                    RowBox[{
                    "MBConicHulls`Private`ResMB_", ",", 
                    "MBConicHulls`Private`MBParaSub_List", ",", 
                    "MBConicHulls`Private`SeriesNum_Integer", ",", 
                    RowBox[{"OptionsPattern", "[", "]"}]}], "]"}], ":=", 
                    RowBox[{"Module", "[", 
                    RowBox[{
                    RowBox[{"{", 
                    
                    RowBox[{"MBConicHulls`Private`CalculateResidueReturn", 
                    ",", "MBConicHulls`Private`SeriesNumber", ",", 
                    RowBox[{"MBConicHulls`Private`TotalSeries", "=", 
                    
                    RowBox[{"MBConicHulls`Private`ResMB", 
                    "\[LeftDoubleBracket]", "7", "\[RightDoubleBracket]"}]}], 
                    ",", "MBConicHulls`Private`Msg4", ",", 
                    "MBConicHulls`Private`TimeTaken", ",", 
                    RowBox[{"MBConicHulls`Private`PrintSol", "=", 
                    RowBox[{"OptionValue", "[", "PrintSeries", "]"}]}], ",", 
                    RowBox[{"MBConicHulls`Private`DumVar", "=", 
                    
                    RowBox[{"MBConicHulls`Private`ResMB", 
                    "\[LeftDoubleBracket]", 
                    RowBox[{"-", "1"}], "\[RightDoubleBracket]"}]}], ",", 
                    RowBox[{"MBConicHulls`Private`Rearrange", "=", 
                    RowBox[{"OptionValue", "[", "RearrangeSeries", "]"}]}], 
                    ",", "MBConicHulls`Private`TrivializeSeriesOut", ",", 
                    "MBConicHulls`Private`Dim", ",", 
                    "MBConicHulls`Private`SumVars", ",", 
                    "MBConicHulls`Private`SeriesCondition", ",", 
                    "MBConicHulls`Private`AllSeries", ",", 
                    RowBox[{"MBConicHulls`Private`Msg3", "=", 
                    RowBox[{"{", "}"}]}], ",", 
                    RowBox[{"MBConicHulls`Private`TrivialQ", "=", "False"}], 
                    ",", "MBConicHulls`Private`SeriesLengthList", ",", 
                    RowBox[{"MBConicHulls`Private`ParQ", "=", 
                    RowBox[{"TrueQ", "[", 
                    RowBox[{"OptionValue", "[", "RunInParallel", "]"}], 
                    "]"}]}]}], "}"}], ",", 
                    RowBox[{
                    RowBox[{"MBConicHulls`Private`TimeTaken", "=", 
                    RowBox[{"AbsoluteTiming", "[", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    
                    RowBox[{"MBConicHulls`Private`SeriesNum", ">", 
                    "MBConicHulls`Private`TotalSeries"}], ",", 
                    RowBox[{
                    
                    RowBox[{"Print", "[", 
                    "\"The series number to be evaluated is greater than the \
total number of series solution found.\"", "]"}], ";", 
                    RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";", 
                    
                    RowBox[{"MBConicHulls`Private`CalculateResidueReturn", 
                    "=", 
                    RowBox[{"MBConicHulls`Private`CalculateResidue", "@@", 
                    RowBox[{"Join", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    
                    RowBox[{"MBConicHulls`Private`ResMB", 
                    "\[LeftDoubleBracket]", "8", "\[RightDoubleBracket]"}], 
                    ",", 
                    RowBox[{
                    
                    RowBox[{"MBConicHulls`Private`ResMB", 
                    "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
                    "\[LeftDoubleBracket]", "MBConicHulls`Private`SeriesNum", 
                    "\[RightDoubleBracket]"}]}], "}"}], "/.", 
                    "\[VeryThinSpace]", "MBConicHulls`Private`MBParaSub"}], 
                    ",", 
                    RowBox[{
                    
                    RowBox[{"MBConicHulls`Private`ResMB", 
                    "\[LeftDoubleBracket]", 
                    RowBox[{"{", 
                    RowBox[{"2", ",", "3", ",", "6"}], "}"}], 
                    "\[RightDoubleBracket]"}], "/.", "\[VeryThinSpace]", 
                    "MBConicHulls`Private`MBParaSub"}], ",", 
                    
                    RowBox[{"MBConicHulls`Private`ResMB", 
