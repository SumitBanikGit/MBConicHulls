Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"MB", "[", 
    RowBox[{"MBRep_", ",", "SubRaw_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "IntVal", ",", "TimeTaken", ",", "MBResolveOut", ",", "MBExpandOut", ",",
        "MBanalytic", ",", "MBRepSub", ",", 
       RowBox[{"Sub", "=", 
        RowBox[{"SubRaw", "/.", 
         RowBox[{"{", 
          RowBox[{
           SubscriptBox["z_", "x_"], "\[RuleDelayed]", 
           RowBox[{"ToExpression", "[", 
            RowBox[{
             RowBox[{"ToString", "@", "z"}], "<>", 
             RowBox[{"ToString", "@", "x"}]}], "]"}]}], "}"}]}]}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"TimeTaken", "=", 
       RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Block", "[", 
          RowBox[{
           RowBox[{"{", "Print", "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"MBRepSub", "=", 
             RowBox[{
              RowBox[{"MBRep", "/.", 
               RowBox[{"{", 
                RowBox[{
                 SubscriptBox["z_", "x_"], "\[RuleDelayed]", 
                 RowBox[{"ToExpression", "[", 
                  RowBox[{
                   RowBox[{"ToString", "@", "z"}], "<>", 
                   RowBox[{"ToString", "@", "x"}]}], "]"}]}], "}"}]}], "/.", 
              "Sub"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"MBResolveOut", "=", 
             RowBox[{
              RowBox[{
               RowBox[{
                RowBox[{"MBresolve", "[", 
                 RowBox[{"#", ",", "eps"}], "]"}], "&"}], "/@", "MBRepSub"}], 
              "//", "Flatten"}]}], ";", "\n", "            ", 
            RowBox[{"MBExpandOut", "=", 
             RowBox[{"MBexpand", "[", 
              RowBox[{"MBResolveOut", ",", "1", ",", 
               RowBox[{"{", 
                RowBox[{"eps", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"MBanalytic", "=", 
             RowBox[{"MBmerge", "[", "MBExpandOut", "]"}]}], ";", 
            "\[IndentingNewLine]", "\[IndentingNewLine]", 
            RowBox[{"IntVal", "=", 
             RowBox[{"MBintegrate", "[", 
              RowBox[{"MBanalytic", ",", "Sub", ",", 
               RowBox[{"MaxPoints", "->", 
                RowBox[{"10", "^", "7"}]}], ",", 
               RowBox[{"PrecisionGoal", "->", "10"}], ",", 
               RowBox[{
               "MBFolder", "->", "\"\</Users/sumitbanik/Documents/MB\>\""}]}],
               "]"}]}]}]}], "]"}], ";", "\[IndentingNewLine]", 
         RowBox[{"Print", "[", 
          
          RowBox[{"\"\<Numerical Integration using MB.m + MBresolve.m -> \>\"",
            ",", 
           RowBox[{"IntVal", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], "]"}], ";"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Time Taken  \>\"", ",", 
        RowBox[{"TimeTaken", "[", 
         RowBox[{"[", "1", "]"}], "]"}], ",", "\"\< seconds\>\""}], "]"}], ";",
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
      RowBox[{"Return", "[", 
       RowBox[{"IntVal", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "]"}]}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.902235685151927*^9, 3.902235711864479*^9}, {
