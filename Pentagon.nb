Cell["Constant Term (0-fold)", "Subsection",
 CellChangeTimes->{{3.874687441734892*^9, 3.8746874548021812`*^9}, {
  3.878105105520825*^9, 
  3.878105109040607*^9}},ExpressionUUID->"eea6fb8d-86a3-4b4f-866f-\
4ba1bd8908d9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ConstantTerm", "=", 
   RowBox[{
    SuperscriptBox[
     SubscriptBox["u", "1"], 
     RowBox[{
      RowBox[{"-", "1"}], "-", "\[Epsilon]"}]], " ", 
    SuperscriptBox[
     SubscriptBox["u", "2"], 
     RowBox[{
      RowBox[{"-", "1"}], "-", "\[Epsilon]"}]], " ", 
    SuperscriptBox[
     SubscriptBox["u", "3"], 
     RowBox[{
      RowBox[{"-", "1"}], "-", "\[Epsilon]"}]], " ", 
    SuperscriptBox[
     SubscriptBox["u", "4"], 
     RowBox[{
      RowBox[{"-", "1"}], "-", "\[Epsilon]"}]], " ", 
    RowBox[{"Gamma", "[", 
     RowBox[{"-", "\[Epsilon]"}], "]"}], " ", 
    SuperscriptBox[
     RowBox[{"Gamma", "[", 
      RowBox[{"1", "+", "\[Epsilon]"}], "]"}], "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        SubscriptBox["u", "1"], 
        RowBox[{"1", "+", "\[Epsilon]"}]], " ", 
       SuperscriptBox[
        SubscriptBox["u", "3"], 
        RowBox[{"1", "+", 
         RowBox[{"2", " ", "\[Epsilon]"}]}]], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{
         RowBox[{"-", "1"}], "-", "\[Epsilon]"}], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"-", "\[Epsilon]"}], "]"}]}], "-", 
      RowBox[{
       SubscriptBox["u", "1"], " ", 
       SuperscriptBox[
        SubscriptBox["u", "3"], 
        RowBox[{"1", "+", 
         RowBox[{"2", " ", "\[Epsilon]"}]}]], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"1", "-", "\[Epsilon]"}], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{
         RowBox[{"-", "2"}], " ", "\[Epsilon]"}], "]"}], " ", 
       RowBox[{"Gamma", "[", "\[Epsilon]", "]"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          SubscriptBox["u", "3"], 
          RowBox[{"1", "+", 
           RowBox[{"2", " ", "\[Epsilon]"}]}]], "+", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["u", "1"], 
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "\[Epsilon]"}]}]], " ", 
          SuperscriptBox[
           SubscriptBox["u", "4"], 
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "\[Epsilon]"}]}]]}], "+", 
         RowBox[{
          SuperscriptBox[
           SubscriptBox["u", "2"], 
           RowBox[{"1", "+", 
            RowBox[{"2", " ", "\[Epsilon]"}]}]], " ", 
          RowBox[{"(", 
           RowBox[{"1", "+", 
            SuperscriptBox[
             SubscriptBox["u", "4"], 
             RowBox[{"1", "+", 
              RowBox[{"2", " ", "\[Epsilon]"}]}]]}], ")"}]}]}], ")"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{
         RowBox[{"-", "1"}], "-", 
         RowBox[{"2", " ", "\[Epsilon]"}]}], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"-", "\[Epsilon]"}], "]"}], " ", 
       RowBox[{"Gamma", "[", 
        RowBox[{"1", "+", "\[Epsilon]"}], "]"}]}]}], ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Term0MB", "[", "Sub_", "]"}], ":=", 
