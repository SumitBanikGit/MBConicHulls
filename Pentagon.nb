        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"Series", "[", 
            RowBox[{"ConstantTerm", ",", 
             RowBox[{"{", 
              RowBox[{"\[Epsilon]", ",", "0", ",", "0"}], "}"}]}], "]"}], "/.",
            "Sub"}], "//", "N"}], "//", "Normal"}], "//", "Chop"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Print", "[", 
       RowBox[{"\"\<Contribution from constant term -> \>\"", ",", 
        "ExpandVal"}], "]"}], ";", " ", 
      RowBox[{"Return", "[", "ExpandVal", "]"}]}]}], "]"}]}], ";"}]}], "Input",
