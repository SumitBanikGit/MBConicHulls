  RowBox[{
   RowBox[{
    RowBox[{"Term1MB3", "[", 
     RowBox[{"Sub_", ",", "Lim_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
