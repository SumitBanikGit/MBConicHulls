Cell[BoxData[
 RowBox[{
  RowBox[{"FIESTAEvaluate", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"URaw_", ",", "FRaw_"}], "}"}], ",", "Loop_Integer", ",", 
    "PropagatorIndices_", ",", "Invariants_", ",", "Sub_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"IntVal", ",", 
      RowBox[{"PropPowers", "=", 
       RowBox[{"PropagatorIndices", "/.", "Sub"}]}], ",", "SymPol", ",", 
      RowBox[{"LoopNum", "=", "Loop"}], ",", "\[IndentingNewLine]", 
      RowBox[{"U", "=", 
       RowBox[{"URaw", "/.", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox["x", "a_"], "\[RuleDelayed]", 
          RowBox[{"x", "[", "a", "]"}]}], "}"}]}]}], ",", 
      RowBox[{"F", "=", 
       RowBox[{"FRaw", "/.", 
        RowBox[{"{", 
         RowBox[{
          SubscriptBox["x", "a_"], "\[RuleDelayed]", 
          RowBox[{"x", "[", "a", "]"}]}], "}"}]}]}], ",", "IntValSub", ",", 
      "TimeTaken"}], "}"}], ",", "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ParallelEvaluate", "[", 
      RowBox[{"Off", "[", 
       RowBox[{"Identity", "::", "argx"}], "]"}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"TimeTaken", "=", " ", 
      RowBox[{"AbsoluteTiming", "[", "\[IndentingNewLine]", " ", 
       RowBox[{
        RowBox[{"F", "=", 
         RowBox[{"F", "/.", "Invariants"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"F", "=", 
         RowBox[{
          RowBox[{"Expand", "@", "F"}], "/.", "Invariants"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"ParallelEvaluate", "[", 
         RowBox[{"Off", "[", 
          RowBox[{"Identity", "::", "argx"}], "]"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"SymPol", "=", 
         RowBox[{"{", 
          RowBox[{"U", ",", 
           RowBox[{"F", "/.", "Sub"}], ",", "LoopNum"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"IntVal", "=", 
         RowBox[{
          RowBox[{"Block", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"Print", ",", 
              RowBox[{"WriteString", "=", "Identity"}], ",", 
              RowBox[{"PrintOutput", "=", "Identity"}]}], "}"}], ",", 
            RowBox[{"SDEvaluate", "[", 
             RowBox[{"SymPol", ",", "PropPowers", ",", "2", ",", 
              RowBox[{"EpVar", "->", "\[Epsilon]"}], ",", 
              RowBox[{"IntegratorOptions", "->", 
               RowBox[{"{", 
                RowBox[{"{", 
                 RowBox[{"\"\<maxeval\>\"", ",", "\"\<10000000\>\""}], "}"}], 
                "}"}]}], ",", 
              RowBox[{"Precision", "->", "7"}], ",", 
              RowBox[{"NumberOfLinks", "->", "8"}], ",", 
              RowBox[{"NumberOfSubkernels", "->", "0"}]}], "]"}]}], "]"}], "//",
           "Quiet"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"IntValSub", "=", 
         RowBox[{"First", "@", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{"IntVal", "*", 
              RowBox[{"Exp", "[", 
               RowBox[{
                RowBox[{"-", "\[Epsilon]"}], " ", "LoopNum", " ", 
                "EulerGamma"}], "]"}], "*", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{
                 FractionBox[
                  SuperscriptBox[
                   RowBox[{"(", 
                    RowBox[{"-", "s"}], ")"}], 
                   RowBox[{
                    RowBox[{"-", "3"}], "-", "\[Epsilon]"}]], 
                  RowBox[{"Gamma", "[", 
                   RowBox[{
                    RowBox[{"-", "1"}], "-", 
                    RowBox[{"2", "\[Epsilon]"}]}], "]"}]], "/.", 
                 RowBox[{"{", 
                  RowBox[{"s", "->", 
                   RowBox[{"-", "1"}]}], "}"}]}], ")"}], 
               RowBox[{"-", "1"}]]}], "/.", "Sub"}], "//", "Expand"}], 
           ")"}]}]}], ";"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<FIESTA Value = \>\"", ",", "Blue"}], "]"}], ",", 
       "IntValSub"}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"Style", "[", 
        RowBox[{"\"\<Time Taken \>\"", ",", "Blue"}], "]"}], ",", 
       RowBox[{"TimeTaken", "[", 
        RowBox[{"[", "1", "]"}], "]"}], ",", 
       RowBox[{"Style", "[", 
        RowBox[{"\"\< seconds\>\"", ",", "Blue"}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "IntVal", "]"}], ";"}]}], "\[IndentingNewLine]", 
   "]"}]}]], "Input",
